<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.AnnotationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Annotate screenshot">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid Padding="18" RowSpacing="14">
        <Grid.Resources>
            <!--  Swatches are the one place a colour is the content, so they are plain
                  circles with a ring, sized to a comfortable target.  -->
            <Style x:Key="SwatchButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>
        </Grid.Resources>
        <!--  A Canvas cannot take keyboard focus, so the drawing surface never
              receives KeyDown. Accelerators on the root keep Enter and Ctrl+Z working
              no matter which toolbar control currently has focus.  -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Enter" Invoked="SaveAccelerator_Invoked" />
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton
                        x:Name="PenTool"
                        MinHeight="36"
                        Click="Tool_Click"
                        Content="Pen"
                        IsChecked="True"
                        Tag="pen" />
                    <ToggleButton
                        x:Name="HighlightTool"
                        MinHeight="36"
                        Click="Tool_Click"
                        Content="Highlight"
                        Tag="highlight" />
                    <ToggleButton
                        x:Name="ArrowTool"
                        MinHeight="36"
                        Click="Tool_Click"
                        Content="Arrow"
                        Tag="arrow" />
                    <ToggleButton
                        x:Name="RectangleTool"
                        MinHeight="36"
                        Click="Tool_Click"
                        Content="Rectangle"
                        Tag="rectangle" />
                    <ToggleButton
                        x:Name="TextTool"
                        MinHeight="36"
                        Click="Tool_Click"
                        Content="Text"
                        Tag="text" />
                </StackPanel>
                <Rectangle
                    Width="1"
                    Height="26"
                    Margin="6,0"
                    VerticalAlignment="Center"
                    Fill="{StaticResource PocketLine}" />
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        Click="Color_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#45E08C"
                        ToolTipService.ToolTip="Green"
                        AutomationProperties.Name="Green">
                        <Ellipse
                            Width="18"
                            Height="18"
                            Fill="#FF45E08C" />
                    </Button>
                    <Button
                        Click="Color_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#FF5F6B"
                        ToolTipService.ToolTip="Red"
                        AutomationProperties.Name="Red">
                        <Ellipse
                            Width="18"
                            Height="18"
                            Fill="#FFFF5F6B" />
                    </Button>
                    <Button
                        Click="Color_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#F0B056"
                        ToolTipService.ToolTip="Amber"
                        AutomationProperties.Name="Amber">
                        <Ellipse
                            Width="18"
                            Height="18"
                            Fill="#FFF0B056" />
                    </Button>
                    <Button
                        Click="Color_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#F2F7F4"
                        ToolTipService.ToolTip="White"
                        AutomationProperties.Name="White">
                        <Ellipse
                            Width="18"
                            Height="18"
                            Fill="#FFF2F7F4" />
                    </Button>
                </StackPanel>
                <Button
                    Margin="6,0,0,0"
                    Click="Undo_Click"
                    Style="{StaticResource PocketQuietButton}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                        <TextBlock Text="Undo" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="Cancel_Click"
                    Content="Keep original"
                    Style="{StaticResource PocketQuietButton}" />
                <Button Click="Save_Click" Style="{StaticResource PocketPrimaryButton}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Save screenshot" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Mono"
                            FontSize="12"
                            IsTextScaleFactorEnabled="False"
                            Opacity="0.62"
                            Text="&#x21B5;" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="10"
            Background="#FF070C0E"
            BorderBrush="{StaticResource PocketLine}"
            BorderThickness="1"
            CornerRadius="{StaticResource PocketCardCorner}">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="Stage">
                    <Image x:Name="ScreenshotImage" Stretch="Fill" />
                    <Canvas
                        x:Name="DrawingSurface"
                        Background="Transparent"
                        PointerMoved="DrawingSurface_PointerMoved"
                        PointerPressed="DrawingSurface_PointerPressed"
                        PointerReleased="DrawingSurface_PointerReleased" />
                </Grid>
            </Viewbox>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock Style="{StaticResource PocketMetaText}" Text="Drawing on the full-resolution image · Enter saves, with or without marks · Ctrl+Z undoes · Esc keeps the original" />
        </Grid>
    </Grid>
</Window>
