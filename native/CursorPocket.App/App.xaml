<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CursorPocket_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CursorPocket_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="PocketInkColor">#FFF4FAF7</Color>
            <Color x:Key="PocketMutedColor">#FF98A9A2</Color>
            <Color x:Key="PocketSurfaceColor">#D9151E24</Color>
            <Color x:Key="PocketRaisedColor">#EE1C2830</Color>
            <Color x:Key="PocketLineColor">#2EFFFFFF</Color>
            <Color x:Key="PocketGreenColor">#FF43E08D</Color>
            <Color x:Key="PocketGreenSoftColor">#3043E08D</Color>
            <Color x:Key="PocketRedColor">#FFFF5A67</Color>
            <Color x:Key="PocketBlueColor">#FF7AB8FF</Color>

            <SolidColorBrush x:Key="PocketInk" Color="{StaticResource PocketInkColor}" />
            <SolidColorBrush x:Key="PocketMuted" Color="{StaticResource PocketMutedColor}" />
            <SolidColorBrush x:Key="PocketSurface" Color="{StaticResource PocketSurfaceColor}" />
            <SolidColorBrush x:Key="PocketRaised" Color="{StaticResource PocketRaisedColor}" />
            <SolidColorBrush x:Key="PocketLine" Color="{StaticResource PocketLineColor}" />
            <SolidColorBrush x:Key="PocketGreen" Color="{StaticResource PocketGreenColor}" />
            <SolidColorBrush x:Key="PocketGreenSoft" Color="{StaticResource PocketGreenSoftColor}" />
            <SolidColorBrush x:Key="PocketRed" Color="{StaticResource PocketRedColor}" />
            <SolidColorBrush x:Key="PocketBlue" Color="{StaticResource PocketBlueColor}" />

            <Style x:Key="PocketDisplayText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PocketInk}" />
                <Setter Property="CharacterSpacing" Value="-20" />
            </Style>
            <Style x:Key="PocketTitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PocketInk}" />
            </Style>
            <Style x:Key="PocketBodyText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource PocketInk}" />
            </Style>
            <Style x:Key="PocketCaptionText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Small" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource PocketMuted}" />
            </Style>
            <Style x:Key="PocketPrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PocketGreen}" />
                <Setter Property="Foreground" Value="#FF07130D" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="PocketQuietButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PocketRaised}" />
                <Setter Property="Foreground" Value="{StaticResource PocketInk}" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="KeyCapButton" TargetType="Button">
                <Setter Property="MinWidth" Value="42" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{StaticResource PocketRaised}" />
                <Setter Property="Foreground" Value="{StaticResource PocketInk}" />
                <Setter Property="BorderBrush" Value="{StaticResource PocketLine}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
