<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CursorPocket_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CursorPocket_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme dictionaries are the only source of app chrome colours. The
                 default dictionary is dark because WinUI resolves "Default" for the
                 dark theme; Light and HighContrast replace the same semantic keys. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PocketInk" Color="#FFF6F4EC" />
                    <SolidColorBrush x:Key="PocketInkDim" Color="#FFCBD7D1" />
                    <SolidColorBrush x:Key="PocketMuted" Color="#FF8EA099" />
                    <SolidColorBrush x:Key="PocketBase" Color="#FF07130F" />
                    <SolidColorBrush x:Key="PocketSunken" Color="#A6070C0B" />
                    <SolidColorBrush x:Key="PocketSurface" Color="#B5101815" />
                    <SolidColorBrush x:Key="PocketRaised" Color="#D9161F1C" />
                    <SolidColorBrush x:Key="PocketTransientSurface" Color="#E6141E1A" />
                    <SolidColorBrush x:Key="PocketLine" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="PocketLineStrong" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="PocketOverlay" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="PocketGreen" Color="#FF36E58C" />
                    <SolidColorBrush x:Key="PocketGreenSoft" Color="#2636E58C" />
                    <SolidColorBrush x:Key="PocketOnGreen" Color="#FF07130F" />
                    <SolidColorBrush x:Key="PocketRed" Color="#FFFF5964" />
                    <SolidColorBrush x:Key="PocketRedSoft" Color="#29FF5964" />
                    <SolidColorBrush x:Key="PocketBlue" Color="#FF7AA7FF" />
                    <SolidColorBrush x:Key="PocketGlassPanel" Color="#B5101815" />
                    <SolidColorBrush x:Key="PocketGlassRaised" Color="#D9161F1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PocketInk" Color="#FF15201C" />
                    <SolidColorBrush x:Key="PocketInkDim" Color="#FF35443E" />
                    <SolidColorBrush x:Key="PocketMuted" Color="#FF5F6E68" />
                    <SolidColorBrush x:Key="PocketBase" Color="#FFF5F9F7" />
                    <SolidColorBrush x:Key="PocketSunken" Color="#B8E4ECE8" />
                    <SolidColorBrush x:Key="PocketSurface" Color="#BDF8FCFA" />
                    <SolidColorBrush x:Key="PocketRaised" Color="#E8FFFFFF" />
                    <SolidColorBrush x:Key="PocketTransientSurface" Color="#EDF7FBF9" />
                    <SolidColorBrush x:Key="PocketLine" Color="#29111D18" />
                    <SolidColorBrush x:Key="PocketLineStrong" Color="#47111D18" />
                    <SolidColorBrush x:Key="PocketOverlay" Color="#10111D18" />
                    <SolidColorBrush x:Key="PocketGreen" Color="#FF168B52" />
                    <SolidColorBrush x:Key="PocketGreenSoft" Color="#26168B52" />
                    <SolidColorBrush x:Key="PocketOnGreen" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="PocketRed" Color="#FFD73546" />
                    <SolidColorBrush x:Key="PocketRedSoft" Color="#24D73546" />
                    <SolidColorBrush x:Key="PocketBlue" Color="#FF276EA8" />
                    <SolidColorBrush x:Key="PocketGlassPanel" Color="#BDF8FCFA" />
                    <SolidColorBrush x:Key="PocketGlassRaised" Color="#E8FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PocketInk" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PocketInkDim" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PocketMuted" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PocketBase" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PocketSunken" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PocketSurface" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PocketRaised" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PocketTransientSurface" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PocketLine" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PocketLineStrong" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PocketOverlay" Color="Transparent" />
                    <SolidColorBrush x:Key="PocketGreen" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PocketGreenSoft" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PocketOnGreen" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PocketRed" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="PocketRedSoft" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PocketBlue" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PocketGlassPanel" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PocketGlassRaised" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Common fallback for the brief interval before a Page is attached to a
                 themed window, and for Windows builds that do not expose a named app
                 theme during XBF construction. Named theme dictionaries override it. -->
            <SolidColorBrush x:Key="PocketInk" Color="#FFF6F4EC" />
            <SolidColorBrush x:Key="PocketInkDim" Color="#FFCBD7D1" />
            <SolidColorBrush x:Key="PocketMuted" Color="#FF8EA099" />
            <SolidColorBrush x:Key="PocketBase" Color="#FF07130F" />
            <SolidColorBrush x:Key="PocketSunken" Color="#A6070C0B" />
            <SolidColorBrush x:Key="PocketSurface" Color="#B5101815" />
            <SolidColorBrush x:Key="PocketRaised" Color="#D9161F1C" />
            <SolidColorBrush x:Key="PocketTransientSurface" Color="#E6141E1A" />
            <SolidColorBrush x:Key="PocketLine" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="PocketLineStrong" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="PocketOverlay" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="PocketGreen" Color="#FF36E58C" />
            <SolidColorBrush x:Key="PocketGreenSoft" Color="#2636E58C" />
            <SolidColorBrush x:Key="PocketOnGreen" Color="#FF07130F" />
            <SolidColorBrush x:Key="PocketRed" Color="#FFFF5964" />
            <SolidColorBrush x:Key="PocketRedSoft" Color="#29FF5964" />
            <SolidColorBrush x:Key="PocketBlue" Color="#FF7AA7FF" />
            <SolidColorBrush x:Key="PocketGlassPanel" Color="#B5101815" />
            <SolidColorBrush x:Key="PocketGlassRaised" Color="#D9161F1C" />
            <SolidColorBrush x:Key="PocketTransparent" Color="Transparent" />

            <!--  Annotation ink. These are the user's marks, not app state, and that is
                  exactly why none of them is a state token: a green arrow on a surface
                  whose selection is green would read as CursorPocket talking. Green is
                  deliberately absent from the palette, so green here always means the
                  active tool or the crop handles. Blue is absent too — it is too close
                  to PocketBlue, which marks text and link captures.  -->
            <Color x:Key="AnnotationInkSignalColor">#FFF4353F</Color>
            <Color x:Key="AnnotationInkAmberColor">#FFF0B056</Color>
            <Color x:Key="AnnotationInkCitronColor">#FFF5E663</Color>
            <Color x:Key="AnnotationInkCyanColor">#FF2FD8E8</Color>
            <Color x:Key="AnnotationInkVioletColor">#FFB57BF0</Color>
            <Color x:Key="AnnotationInkChalkColor">#FFFFFFFF</Color>

            <SolidColorBrush x:Key="AnnotationInkSignal" Color="{StaticResource AnnotationInkSignalColor}" />
            <SolidColorBrush x:Key="AnnotationInkAmber" Color="{StaticResource AnnotationInkAmberColor}" />
            <SolidColorBrush x:Key="AnnotationInkCitron" Color="{StaticResource AnnotationInkCitronColor}" />
            <SolidColorBrush x:Key="AnnotationInkCyan" Color="{StaticResource AnnotationInkCyanColor}" />
            <SolidColorBrush x:Key="AnnotationInkViolet" Color="{StaticResource AnnotationInkVioletColor}" />
            <SolidColorBrush x:Key="AnnotationInkChalk" Color="{StaticResource AnnotationInkChalkColor}" />

            <!--  One canonical cursor, shared by the brand pipeline in tools/make_brand_assets.py.
                  A Setter converts the literal to a Geometry; a plain string resource would
                  reach Path.Data untyped and fail at load.  -->
            <Style x:Key="PocketCursorMark" TargetType="Path">
                <Setter Property="Data" Value="M0,0 L0,26.5 L7.2,20.1 L11.6,30.6 L16.4,28.6 L12.1,18.3 L21.4,17.6 Z" />
                <Setter Property="Fill" Value="{ThemeResource PocketGreen}" />
                <Setter Property="Stretch" Value="Uniform" />
            </Style>

            <CornerRadius x:Key="PocketControlCorner">8</CornerRadius>
            <CornerRadius x:Key="PocketCardCorner">12</CornerRadius>
            <CornerRadius x:Key="PocketWellCorner">16</CornerRadius>

            <!--  Type. Display for headings, Text for controls, Cascadia Mono for anything
                  the eye has to compare: keys, timers, sizes, counts, paths.  -->
            <Style x:Key="PocketDisplayText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource PocketInk}" />
                <Setter Property="CharacterSpacing" Value="-21" />
                <Setter Property="LineHeight" Value="38" />
            </Style>
            <Style x:Key="PocketTitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource PocketInk}" />
                <Setter Property="CharacterSpacing" Value="-12" />
            </Style>
            <Style x:Key="PocketSubtitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource PocketInk}" />
            </Style>
            <Style x:Key="PocketBodyText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource PocketInk}" />
            </Style>
            <Style x:Key="PocketBodyStrongText" TargetType="TextBlock" BasedOn="{StaticResource PocketBodyText}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="PocketCaptionText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource PocketInkDim}" />
                <Setter Property="LineHeight" Value="18" />
            </Style>
            <Style x:Key="PocketMetaText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Small" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource PocketMuted}" />
            </Style>
            <Style x:Key="PocketNumericText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource PocketMuted}" />
                <Setter Property="IsTextScaleFactorEnabled" Value="False" />
            </Style>
            <Style x:Key="PocketLabelText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource PocketMuted}" />
            </Style>

            <!--  Buttons. One template, four roles, so height, radius, and the hover and
                  pressed response are identical wherever a button appears.  -->
            <Style x:Key="PocketButtonBase" TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="{StaticResource PocketControlCorner}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource PocketInk}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Border x:Name="Overlay" Background="{ThemeResource PocketOverlay}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                <Border x:Name="PressOverlay" Background="{ThemeResource PocketOverlay}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                <ContentPresenter
                                    x:Name="Presenter"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Overlay"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.09" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Overlay"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="PressOverlay"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Presenter"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.75"
                                                    Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Root"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.38"
                                                    Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PocketProminentButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
                <Setter Property="MinHeight" Value="40" />
            </Style>
            <Style x:Key="PocketTouchButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
                <Setter Property="MinHeight" Value="44" />
            </Style>

            <Style x:Key="PocketPrimaryButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
                <Setter Property="Background" Value="{ThemeResource PocketGreen}" />
                <Setter Property="Foreground" Value="{ThemeResource PocketOnGreen}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,0" />
            </Style>
            <Style x:Key="PocketQuietButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
                <Setter Property="Background" Value="{ThemeResource PocketRaised}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PocketLine}" />
            </Style>
            <Style x:Key="PocketGhostButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
                <Setter Property="Foreground" Value="{ThemeResource PocketInkDim}" />
            </Style>
            <Style x:Key="PocketDangerButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
                <Setter Property="Foreground" Value="{ThemeResource PocketRed}" />
            </Style>
            <Style x:Key="PocketIconButton" TargetType="Button" BasedOn="{StaticResource PocketGhostButton}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="PocketDangerIconButton" TargetType="Button" BasedOn="{StaticResource PocketDangerButton}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="PocketTileButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
                <Setter Property="Background" Value="{ThemeResource PocketSurface}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PocketLine}" />
                <Setter Property="CornerRadius" Value="{StaticResource PocketCardCorner}" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="PocketCommandRow" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <!--  A key chip is a real key: fixed height, mono, and a heavier bottom edge.  -->
            <Style x:Key="KeyCapButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{ThemeResource PocketRaised}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PocketLineStrong}" />
                <Setter Property="BorderThickness" Value="1,1,1,2" />
                <Setter Property="IsTextScaleFactorEnabled" Value="False" />
            </Style>
            <Style x:Key="KeyCapLargeButton" TargetType="Button" BasedOn="{StaticResource KeyCapButton}">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>
            <Style x:Key="PocketKeycap" TargetType="Border">
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Background" Value="{ThemeResource PocketRaised}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PocketLineStrong}" />
                <Setter Property="BorderThickness" Value="1,1,1,2" />
            </Style>

            <!--  Annotation toolbar. A tool button is an icon plus its own key, engraved:
                  the toolbar teaches its shortcuts instead of hiding them in a legend.
                  46 wide at full width; the letter column collapses when the window is
                  too narrow, which degrades the teaching and never the capability.  -->
            <Style x:Key="PocketToolButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
            <!--  A swatch is the one place a colour is the content, so it stays a plain
                  disc. Its numeral is the key, matching the tool buttons.  -->
            <Style x:Key="PocketSwatchButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!--  Tool icons. 19 px of content inside a 24 px box on a 2 px round-capped
                  stroke: the proportions are what make a dense toolbar read as an
                  instrument rather than a puzzle. Stretch is None, so every geometry
                  below is authored directly in that 24 px box, inside [2.5, 21.5].  -->
            <Style x:Key="PocketToolIconStroke" TargetType="Path">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Stretch" Value="None" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="Stroke" Value="{ThemeResource PocketInkDim}" />
            </Style>
            <!--  The highlighter icon is drawn with a highlighter's own nib width.  -->
            <Style x:Key="PocketToolIconStrokeHeavy" TargetType="Path" BasedOn="{StaticResource PocketToolIconStroke}">
                <Setter Property="StrokeThickness" Value="5" />
                <Setter Property="Opacity" Value="0.55" />
            </Style>
            <Style x:Key="PocketToolIconStrokeHair" TargetType="Path" BasedOn="{StaticResource PocketToolIconStroke}">
                <Setter Property="StrokeThickness" Value="1.4" />
                <Setter Property="StrokeDashArray" Value="2,2" />
            </Style>
            <Style x:Key="PocketToolIconFill" TargetType="Path">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Stretch" Value="None" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{ThemeResource PocketInkDim}" />
            </Style>


            <!--  The engraved key on a tool button. A bare mono letter, not a KeyCap
                  chip: a chip inside a button double-nests interactive-looking elements,
                  which is the trap command mode had to walk the visual tree to work
                  around. An engraved letter is quieter and more instrument-like.  -->
            <Style x:Key="ToolKeyText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource PocketMuted}" />
                <Setter Property="IsTextScaleFactorEnabled" Value="False" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,7,0" />
            </Style>
            <Style x:Key="ToolbarDivider" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{ThemeResource PocketLine}" />
            </Style>

            <!--  Icon geometry is written inline as Path.Data at each use site, not held
                  here as PathGeometry resources. WinUI only parses the abbreviated
                  "M4,20 L20,4" syntax through Path.Data's own type converter:
                  PathGeometry.Figures rejects it outright (WMC0055), and an x:String
                  resource reaches Path.Data untyped and fails at load. That is the same
                  constraint PocketCursorMark's comment records. The styles above carry
                  the part worth sharing — box size, stroke weight, caps, joins, brush.  -->

            <!--  Containers  -->
            <Style x:Key="PocketCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PocketSurface}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PocketLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PocketCardCorner}" />
            </Style>
            <Style x:Key="PocketWell" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PocketSunken}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PocketLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PocketWellCorner}" />
            </Style>
            <!--  Kind chips stay neutral. The glyph and the mono tag carry the kind, so a
                  coloured surface always means live state rather than decoration.  -->
            <Style x:Key="PocketChip" TargetType="Border">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Background" Value="{ThemeResource PocketSunken}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PocketLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PocketControlCorner}" />
            </Style>
            <Style x:Key="PocketChipLarge" TargetType="Border" BasedOn="{StaticResource PocketChip}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
            </Style>
            <Style x:Key="PocketTagBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource PocketLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="6,3" />
            </Style>
            <Style x:Key="PocketTagText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{ThemeResource PocketMuted}" />
                <Setter Property="IsTextScaleFactorEnabled" Value="False" />
            </Style>

            <Style x:Key="PocketChipIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource PocketInkDim}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

