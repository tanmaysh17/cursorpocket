<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.CameraSelfViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CursorPocket camera">
    <!-- The camera frame remains unaltered. Only the fallback and status chrome use
         semantic theme colours, so a denied camera never becomes a black rectangle. -->
    <Grid
        x:Name="Root"
        Background="{ThemeResource PocketBase}"
        PointerPressed="Root_PointerPressed"
        PointerMoved="Root_PointerMoved"
        PointerReleased="Root_PointerReleased"
        PointerCaptureLost="Root_PointerCaptureLost"
        ToolTipService.ToolTip="Drag to move your camera inside the recording">
        <MediaPlayerElement x:Name="CameraPreview" AreTransportControlsEnabled="False" Stretch="UniformToFill" />
        <!-- Effects path: frames processed by the camera effect pipeline land here
             instead of the MediaPlayerElement. Exactly one of the two is active. -->
        <Image x:Name="CameraEffectView" Stretch="UniformToFill" Visibility="Collapsed" />
        <TextBlock
            x:Name="CameraStatus"
            Margin="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            Text="Camera unavailable"
            Style="{StaticResource PocketCaptionText}" />
        <Border BorderBrush="{ThemeResource PocketMediaGreen}" BorderThickness="1" Opacity="0.42" IsHitTestVisible="False" />
    </Grid>
</Window>

