<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.CameraSelfViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CursorPocket camera">
    <!-- Opaque edge to edge: a transparent WinUI root would show a light gutter,
         and this surface is deliberately visible in the recording. -->
    <Grid Background="#FF09110F">
        <MediaPlayerElement x:Name="CameraPreview" AreTransportControlsEnabled="False" Stretch="UniformToFill" />
        <TextBlock
            x:Name="CameraStatus"
            Margin="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            Text="Camera unavailable"
            Style="{StaticResource PocketCaptionText}" />
        <Border BorderBrush="{StaticResource PocketGreen}" BorderThickness="1" Opacity="0.42" IsHitTestVisible="False" />
    </Grid>
</Window>
