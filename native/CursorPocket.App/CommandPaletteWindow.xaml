<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.CommandPaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CursorPocket command mode">
    <Grid
        x:Name="Root"
        Background="#FF030A08"
        KeyDown="Root_KeyDown"
        Loaded="Root_Loaded"
        PointerMoved="Root_PointerMoved">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="S" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="V" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="V" Modifiers="Shift" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="A" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="T" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="L" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="O" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="R" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="W" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="D" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="P" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="CommandAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <!--  The brand mark breathes instead of duplicating itself, so a still frame
                  never looks like a rendering fault.  -->
            <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation
                    AutoReverse="True"
                    Storyboard.TargetName="BrandMark"
                    Storyboard.TargetProperty="Opacity"
                    From="1.0"
                    To="0.38"
                    Duration="0:0:1.35" />
            </Storyboard>
        </Grid.Resources>

        <!--  The frozen desktop keeps the user's context; everything above it is a veil.  -->
        <Image x:Name="BackdropImage" IsHitTestVisible="False" Stretch="Fill" />
        <Rectangle Fill="#26030A08" IsHitTestVisible="False" />

        <!--  A single scrim, ramped over 900 px, so there is no panel edge to catch the eye.  -->
        <Border
            Width="900"
            HorizontalAlignment="Right"
            IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Offset="0" Color="#00080E0C" />
                    <GradientStop Offset="0.34" Color="#57080E0C" />
                    <GradientStop Offset="0.62" Color="#C7070C0A" />
                    <GradientStop Offset="1" Color="#F2060B09" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!--  The green field reads on all four edges and sits above the scrim, so command
              mode is unmistakable no matter what is underneath it.  -->
        <Grid IsHitTestVisible="False">
            <Rectangle Height="150" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0" Color="#3345E08C" />
                        <GradientStop Offset="1" Color="#0045E08C" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="150" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop Offset="0" Color="#3345E08C" />
                        <GradientStop Offset="1" Color="#0045E08C" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="150" HorizontalAlignment="Left">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#3345E08C" />
                        <GradientStop Offset="1" Color="#0045E08C" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="150" HorizontalAlignment="Right">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                        <GradientStop Offset="0" Color="#3345E08C" />
                        <GradientStop Offset="1" Color="#0045E08C" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Stroke="#5745E08C" StrokeThickness="1" />
        </Grid>

        <StackPanel
            Width="452"
            Margin="0,0,56,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="PaletteTitle"
                        FontSize="26"
                        Style="{StaticResource PocketTitleText}"
                        Text="What do you want to catch?" />
                    <TextBlock
                        x:Name="PaletteHint"
                        Style="{StaticResource PocketCaptionText}"
                        Text="Press one key." />
                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="Close_Click"
                    Style="{StaticResource PocketIconButton}"
                    ToolTipService.ToolTip="Close command mode">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <!--  The three captures that carry the product get the weight. Everything else
                  is demoted below the rule.  -->
            <StackPanel x:Name="PrimaryCommands" Margin="0,20,0,0">
                <StackPanel Spacing="4">
                <Button
                    x:Name="ScreenshotCommand"
                    Click="Command_Click"
                    Style="{StaticResource PocketCommandRow}"
                    Tag="screenshot">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            HorizontalAlignment="Right"
                            Content="S"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Style="{StaticResource KeyCapLargeButton}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="15"
                                Style="{StaticResource PocketSubtitleText}"
                                Text="Screenshot" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource PocketMetaText}"
                                Text="Region, window, or display" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button
                    Click="Command_Click"
                    Style="{StaticResource PocketCommandRow}"
                    Tag="video">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            HorizontalAlignment="Right"
                            Content="V"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Style="{StaticResource KeyCapLargeButton}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="15"
                                Style="{StaticResource PocketSubtitleText}"
                                Text="Video" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource PocketMetaText}"
                                Text="Screen, microphone, and camera" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button
                    Click="Command_Click"
                    Style="{StaticResource PocketCommandRow}"
                    Tag="audio">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            HorizontalAlignment="Right"
                            Content="A"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Style="{StaticResource KeyCapLargeButton}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="15"
                                Style="{StaticResource PocketSubtitleText}"
                                Text="Audio note" />
                            <TextBlock
                                x:Name="AudioDeviceHint"
                                Margin="0,2,0,0"
                                Style="{StaticResource PocketMetaText}"
                                Text="Starts with your remembered microphone"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Button>
                </StackPanel>

                <Rectangle
                    Height="1"
                    Margin="0,16"
                    Fill="{StaticResource PocketLine}" />

                <StackPanel x:Name="SecondaryCommands" Spacing="2">
                <Button
                    Click="Command_Click"
                    Style="{StaticResource PocketCommandRow}"
                    Tag="text">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            HorizontalAlignment="Right"
                            Content="T"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Style="{StaticResource KeyCapButton}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource PocketInkDim}"
                            Style="{StaticResource PocketBodyText}"
                            Text="Highlighted text" />
                    </Grid>
                </Button>
                <Button
                    Click="Command_Click"
                    Style="{StaticResource PocketCommandRow}"
                    Tag="link">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            HorizontalAlignment="Right"
                            Content="L"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Style="{StaticResource KeyCapButton}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource PocketInkDim}"
                            Style="{StaticResource PocketBodyText}"
                            Text="Current web link" />
                    </Grid>
                </Button>
                <Button
                    Click="Command_Click"
                    Style="{StaticResource PocketCommandRow}"
                    Tag="repeat-video">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                Content="Shift"
                                FontSize="12"
                                IsHitTestVisible="False"
                                IsTabStop="False"
                                Style="{StaticResource KeyCapButton}" />
                            <Button
                                Content="V"
                                IsHitTestVisible="False"
                                IsTabStop="False"
                                Style="{StaticResource KeyCapButton}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource PocketInkDim}"
                            Style="{StaticResource PocketBodyText}"
                            Text="Repeat last video setup" />
                    </Grid>
                </Button>
                <Button
                    Click="Command_Click"
                    Style="{StaticResource PocketCommandRow}"
                    Tag="library">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Letter O"
                            Content="O"
                            FontFamily="Segoe UI Variable Display"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Style="{StaticResource KeyCapButton}"
                            ToolTipService.ToolTip="Letter O" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource PocketInkDim}"
                            Style="{StaticResource PocketBodyText}"
                            Text="Open Library" />
                    </Grid>
                </Button>
                </StackPanel>
            </StackPanel>

            <!--  Screenshot is explicitly sequential: S, then one of five.  -->
            <StackPanel
                x:Name="ScreenshotCommands"
                Margin="0,4,0,0"
                Spacing="8"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Content="S"
                        IsHitTestVisible="False"
                        IsTabStop="False"
                        Style="{StaticResource KeyCapButton}" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource PocketMuted}"
                        Glyph="&#xE76C;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource PocketMetaText}"
                        Text="then press one screenshot key" />
                </StackPanel>
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Button
                        x:Name="RegionCommand"
                        Click="Command_Click"
                        Style="{StaticResource PocketTileButton}"
                        Tag="region">
                        <StackPanel Spacing="10">
                            <Button
                                HorizontalAlignment="Left"
                                Content="R"
                                IsHitTestVisible="False"
                                IsTabStop="False"
                                Style="{StaticResource KeyCapButton}" />
                            <TextBlock Style="{StaticResource PocketBodyText}" Text="Region" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Click="Command_Click"
                        Style="{StaticResource PocketTileButton}"
                        Tag="window">
                        <StackPanel Spacing="10">
                            <Button
                                HorizontalAlignment="Left"
                                Content="W"
                                IsHitTestVisible="False"
                                IsTabStop="False"
                                Style="{StaticResource KeyCapButton}" />
                            <TextBlock Style="{StaticResource PocketBodyText}" Text="Window" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Click="Command_Click"
                        Style="{StaticResource PocketTileButton}"
                        Tag="display">
                        <StackPanel Spacing="10">
                            <Button
                                HorizontalAlignment="Left"
                                Content="D"
                                IsHitTestVisible="False"
                                IsTabStop="False"
                                Style="{StaticResource KeyCapButton}" />
                            <TextBlock Style="{StaticResource PocketBodyText}" Text="Display" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Row="1"
                        Click="Command_Click"
                        Style="{StaticResource PocketTileButton}"
                        Tag="all-displays">
                        <StackPanel Spacing="10">
                            <Button
                                HorizontalAlignment="Left"
                                Content="A"
                                IsHitTestVisible="False"
                                IsTabStop="False"
                                Style="{StaticResource KeyCapButton}" />
                            <TextBlock Style="{StaticResource PocketBodyText}" Text="All displays" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Click="Command_Click"
                        Style="{StaticResource PocketTileButton}"
                        Tag="previous-region">
                        <StackPanel Spacing="10">
                            <Button
                                HorizontalAlignment="Left"
                                Content="P"
                                IsHitTestVisible="False"
                                IsTabStop="False"
                                Style="{StaticResource KeyCapButton}" />
                            <TextBlock Style="{StaticResource PocketBodyText}" Text="Previous" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Row="1"
                        Grid.Column="2"
                        Click="Command_Click"
                        Style="{StaticResource PocketCommandRow}"
                        Tag="back">
                        <StackPanel Spacing="10">
                            <Button
                                HorizontalAlignment="Left"
                                Content="Esc"
                                FontSize="12"
                                IsHitTestVisible="False"
                                IsTabStop="False"
                                Style="{StaticResource KeyCapButton}" />
                            <TextBlock Style="{StaticResource PocketMetaText}" Text="Back" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel
                Margin="0,18,0,0"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    Height="24"
                    MinHeight="24"
                    MinWidth="24"
                    Padding="7,0"
                    Content="Esc"
                    FontSize="11"
                    IsHitTestVisible="False"
                    IsTabStop="False"
                    Style="{StaticResource KeyCapButton}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource PocketMetaText}"
                    Text="closes · nothing here changes normal typing" />
            </StackPanel>
        </StackPanel>

        <!--  The mark alone, per the brand rule: no disc, no container, no wordmark.  -->
        <Button
            Width="56"
            Height="56"
            Margin="0,0,32,28"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Click="LibraryPulse_Click"
            Style="{StaticResource PocketGhostButton}"
            ToolTipService.ToolTip="Open the full CursorPocket Library">
            <Path
                x:Name="BrandMark"
                Width="24"
                Height="34"
                Style="{StaticResource PocketCursorMark}" />
        </Button>
    </Grid>
</Window>
