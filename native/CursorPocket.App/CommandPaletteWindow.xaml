<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.CommandPaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CursorPocket command mode">
    <Grid
        x:Name="Root"
        Background="Transparent"
        DoubleTapped="Root_DoubleTapped"
        KeyDown="Root_KeyDown"
        Loaded="Root_Loaded"
        PointerCaptureLost="Root_PointerCaptureLost"
        PointerMoved="Root_PointerMoved"
        PointerPressed="Root_PointerPressed"
        PointerReleased="Root_PointerReleased">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="S" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="V" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="V" Modifiers="Shift" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="A" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="T" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="L" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="O" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="R" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="W" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="D" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="P" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="CommandAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <!-- Keep the system backdrop directly visible. In WinUI 3 an element-level
             Acrylic brush only samples XAML inside this window, so a full-shell
             layer here turns desktop glass into a flat tint. -->
        <Border Margin="1" BorderBrush="{ThemeResource PocketGlassRim}" BorderThickness="1" CornerRadius="13" IsHitTestVisible="False" />
        <Border Margin="1" BorderBrush="{ThemeResource PocketGlassTopEdge}" BorderThickness="0,1,0,0" CornerRadius="13" IsHitTestVisible="False" />
        <Border BorderBrush="{ThemeResource PocketGreen}" BorderThickness="1" CornerRadius="14" IsHitTestVisible="False" Opacity="0.28" />

        <Grid Padding="14,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Width="44"
                    Height="44"
                    Padding="0"
                    Click="Library_Click"
                    Style="{StaticResource PocketIconButton}"
                    ToolTipService.ToolTip="Open Library"
                    AutomationProperties.Name="Open Library">
                    <Grid Width="40" Height="40">
                        <Image Width="40" Height="40" Source="ms-appx:///Assets/CursorPocketLogo.png" Stretch="Uniform" />
                    </Grid>
                </Button>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PocketMetaText}" Text="Command mode" />
                <Button Grid.Column="2" Click="Close_Click" Style="{StaticResource PocketIconButton}" ToolTipService.ToolTip="Close · Esc" AutomationProperties.Name="Close command mode">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <TextBlock x:Name="PaletteTitle" Grid.Row="1" Style="{StaticResource PocketSubtitleText}" Text="What do you want to capture?" />
            <Grid Grid.Row="2">
                <Grid x:Name="PrimaryCommands" RowSpacing="4" ColumnSpacing="4" />
                <Grid x:Name="ScreenshotCommands" RowSpacing="6" ColumnSpacing="6" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="PaletteHint" Grid.Row="3" Style="{StaticResource PocketCaptionText}" Text="Choose an action or press its key · Esc closes" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>

