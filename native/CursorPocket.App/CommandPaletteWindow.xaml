<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.CommandPaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CursorPocket command mode">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" KeyDown="Root_KeyDown" PointerMoved="Root_PointerMoved" Loaded="Root_Loaded" Background="#12030A08">
        <Grid.Resources>
            <Style x:Key="CommandRow" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="8,9" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" From="0.38" To="0.08" Duration="0:0:1.35" />
                <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.72" To="1.12" Duration="0:0:1.35" />
                <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.72" To="1.12" Duration="0:0:1.35" />
            </Storyboard>
        </Grid.Resources>

        <Border BorderBrush="{StaticResource PocketGreen}" BorderThickness="2,2,0,2" Opacity="0.14" />
        <Border Margin="0" HorizontalAlignment="Right" Width="620">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#00111A16" Offset="0" />
                    <GradientStop Color="#B20E1714" Offset="0.36" />
                    <GradientStop Color="#F20A100E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Width="440" Margin="0,40,34,0" Spacing="16">
            <Grid>
                <StackPanel Spacing="3">
                    <TextBlock Text="COMMAND MODE" Foreground="{StaticResource PocketGreen}" FontFamily="Cascadia Mono" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" />
                    <TextBlock x:Name="PaletteTitle" Text="What do you want to catch?" Style="{StaticResource PocketTitleText}" />
                    <TextBlock x:Name="PaletteHint" Text="Press one key. Nothing here affects normal typing." Style="{StaticResource PocketCaptionText}" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click" Background="Transparent" ToolTipService.ToolTip="Close command mode">
                    <FontIcon Glyph="&#xE711;" />
                </Button>
            </Grid>

            <StackPanel x:Name="PrimaryCommands" Spacing="3">
                <Button Style="{StaticResource CommandRow}" Tag="screenshot" Click="Command_Click">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="S" IsHitTestVisible="False" Style="{StaticResource KeyCapButton}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Screenshot" Style="{StaticResource PocketBodyText}" /><TextBlock Text="Choose a region, window, or display" Style="{StaticResource PocketCaptionText}" /></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" Glyph="&#xE76C;" Foreground="{StaticResource PocketMuted}" /></Grid>
                </Button>
                <Button Style="{StaticResource CommandRow}" Tag="video" Click="Command_Click">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="V" IsHitTestVisible="False" Style="{StaticResource KeyCapButton}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Video" Style="{StaticResource PocketBodyText}" /><TextBlock Text="Confirm source, microphone, and camera first" Style="{StaticResource PocketCaptionText}" /></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" Glyph="&#xE714;" Foreground="{StaticResource PocketGreen}" /></Grid>
                </Button>
                <Button Style="{StaticResource CommandRow}" Tag="repeat-video" Click="Command_Click">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="5"><Button Content="Shift" IsHitTestVisible="False" Style="{StaticResource KeyCapButton}" /><TextBlock VerticalAlignment="Center" Text="+" Foreground="{StaticResource PocketMuted}" /><Button Content="V" IsHitTestVisible="False" Style="{StaticResource KeyCapButton}" /></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Repeat last video setup" Style="{StaticResource PocketBodyText}" /><TextBlock Text="Uses your remembered source and devices" Style="{StaticResource PocketCaptionText}" /></StackPanel></Grid>
                </Button>
                <Button Style="{StaticResource CommandRow}" Tag="audio" Click="Command_Click">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="A" IsHitTestVisible="False" Style="{StaticResource KeyCapButton}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Audio note" Style="{StaticResource PocketBodyText}" /><TextBlock x:Name="AudioDeviceHint" Text="Starts with your remembered microphone" Style="{StaticResource PocketCaptionText}" /></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" Glyph="&#xE720;" Foreground="{StaticResource PocketGreen}" /></Grid>
                </Button>
                <Button Style="{StaticResource CommandRow}" Tag="text" Click="Command_Click">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="T" IsHitTestVisible="False" Style="{StaticResource KeyCapButton}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Highlighted text" Style="{StaticResource PocketBodyText}" /><TextBlock Text="Saves only the selection in your previous window" Style="{StaticResource PocketCaptionText}" /></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" Glyph="&#xE8C1;" Foreground="{StaticResource PocketBlue}" /></Grid>
                </Button>
                <Button Style="{StaticResource CommandRow}" Tag="link" Click="Command_Click">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="L" IsHitTestVisible="False" Style="{StaticResource KeyCapButton}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Current web link" Style="{StaticResource PocketBodyText}" /><TextBlock Text="Does nothing outside a supported browser" Style="{StaticResource PocketCaptionText}" /></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" Glyph="&#xE71B;" Foreground="{StaticResource PocketBlue}" /></Grid>
                </Button>
                <Button Style="{StaticResource CommandRow}" Tag="library" Click="Command_Click">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="O" IsHitTestVisible="False" Style="{StaticResource KeyCapButton}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Open Library" Style="{StaticResource PocketBodyText}" /><TextBlock Text="See, play, reveal, or remove captures" Style="{StaticResource PocketCaptionText}" /></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" Glyph="&#xE8B9;" Foreground="{StaticResource PocketMuted}" /></Grid>
                </Button>
            </StackPanel>

            <StackPanel x:Name="ScreenshotCommands" Visibility="Collapsed" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="7"><Button Content="S" IsHitTestVisible="False" Style="{StaticResource KeyCapButton}" /><FontIcon Glyph="&#xE76C;" Foreground="{StaticResource PocketMuted}" /><TextBlock VerticalAlignment="Center" Text="then press one screenshot key" Style="{StaticResource PocketCaptionText}" /></StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <Button Tag="region" Click="Command_Click" Margin="3" Padding="12" CornerRadius="12" Background="{StaticResource PocketRaised}"><StackPanel><TextBlock Text="R" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="18" /><TextBlock Text="Region" Style="{StaticResource PocketBodyText}" /></StackPanel></Button>
                    <Button Grid.Column="1" Tag="window" Click="Command_Click" Margin="3" Padding="12" CornerRadius="12" Background="{StaticResource PocketRaised}"><StackPanel><TextBlock Text="W" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="18" /><TextBlock Text="Window" Style="{StaticResource PocketBodyText}" /></StackPanel></Button>
                    <Button Grid.Column="2" Tag="display" Click="Command_Click" Margin="3" Padding="12" CornerRadius="12" Background="{StaticResource PocketRaised}"><StackPanel><TextBlock Text="D" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="18" /><TextBlock Text="Display" Style="{StaticResource PocketBodyText}" /></StackPanel></Button>
                    <Button Grid.Row="1" Tag="all-displays" Click="Command_Click" Margin="3" Padding="12" CornerRadius="12" Background="{StaticResource PocketRaised}"><StackPanel><TextBlock Text="A" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="18" /><TextBlock Text="All displays" Style="{StaticResource PocketBodyText}" /></StackPanel></Button>
                    <Button Grid.Row="1" Grid.Column="1" Tag="previous-region" Click="Command_Click" Margin="3" Padding="12" CornerRadius="12" Background="{StaticResource PocketRaised}"><StackPanel><TextBlock Text="P" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="18" /><TextBlock Text="Previous" Style="{StaticResource PocketBodyText}" /></StackPanel></Button>
                    <Button Grid.Row="1" Grid.Column="2" Tag="back" Click="Command_Click" Margin="3" Padding="12" CornerRadius="12" Background="Transparent"><StackPanel><TextBlock Text="Esc" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketMuted}" FontSize="14" /><TextBlock Text="Back" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                </Grid>
            </StackPanel>

            <Grid Margin="6,4,6,0">
                <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="7" Height="7" Fill="{StaticResource PocketGreen}" /><TextBlock Text="Closes after 30 seconds of inactivity" Style="{StaticResource PocketCaptionText}" /></StackPanel>
                <TextBlock HorizontalAlignment="Right" Text="Esc closes" Style="{StaticResource PocketCaptionText}" />
            </Grid>
        </StackPanel>

        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="76" Height="76" Margin="0,0,28,26" Padding="0" Background="Transparent" BorderThickness="0" Click="LibraryPulse_Click" ToolTipService.ToolTip="Open the full CursorPocket Library">
            <Grid Width="74" Height="74">
                <Ellipse x:Name="PulseRing" Fill="{StaticResource PocketGreen}" Opacity="0.34" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform ScaleX="0.82" ScaleY="0.82" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="48" Height="48" Fill="#C70A1710" />
                <Path Width="23" Height="29" Data="M2,1 L21,16 L13,18 L17,27 L13,29 L9,20 L2,25 Z" Fill="{StaticResource PocketGreen}" Stretch="Fill" />
            </Grid>
        </Button>
    </Grid>
</Window>
