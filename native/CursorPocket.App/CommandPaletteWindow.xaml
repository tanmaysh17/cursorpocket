<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.CommandPaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CursorPocket command mode">
    <!-- Command mode is the one transient surface that uses a system backdrop.
         Acrylic blurs the live desktop behind the panel, so a small panel still
         reads as part of the source rather than a box sitting on top of it. The
         system paints the whole window, so there is no transparent WinUI gutter. -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" KeyDown="Root_KeyDown" PointerMoved="Root_PointerMoved" Loaded="Root_Loaded" Background="Transparent">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="S" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="V" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="V" Modifiers="Shift" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="A" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="T" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="L" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="O" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="R" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="W" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="D" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="P" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="CommandAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <Style x:Key="CommandRow" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="CompactKeyCap" TargetType="Button" BasedOn="{StaticResource KeyCapButton}">
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="5,2" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="ScreenshotTile" TargetType="Button">
                <Setter Property="Margin" Value="2" />
                <Setter Property="Padding" Value="6,5" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{StaticResource PocketRaised}" />
            </Style>
            <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" From="0.38" To="0.08" Duration="0:0:1.35" />
                <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.72" To="1.12" Duration="0:0:1.35" />
                <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.72" To="1.12" Duration="0:0:1.35" />
            </Storyboard>
        </Grid.Resources>

        <!-- A thin tint over the acrylic: enough for text contrast over bright
             source content, light enough that the desktop still reads through. -->
        <Rectangle Fill="#3C060D0B" IsHitTestVisible="False" />
        <Border BorderBrush="{StaticResource PocketGreen}" BorderThickness="1" CornerRadius="14" Opacity="0.3" IsHitTestVisible="False" />

        <Grid Padding="12,10,12,9" RowSpacing="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Click="LibraryPulse_Click" ToolTipService.ToolTip="Open the full CursorPocket Library" AutomationProperties.Name="Open the full CursorPocket Library">
                    <Grid Width="22" Height="22">
                        <Ellipse x:Name="PulseRing" Width="20" Height="20" Fill="{StaticResource PocketGreen}" Opacity="0.34" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Image Source="ms-appx:///Assets/CursorPocketLogo.png" Width="21" Height="21" Stretch="Uniform" />
                    </Grid>
                </Button>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="COMMAND MODE" Foreground="{StaticResource PocketGreen}" FontFamily="Cascadia Mono" FontSize="10" FontWeight="SemiBold" CharacterSpacing="110" />
                <Button Grid.Column="2" VerticalAlignment="Center" Padding="4" Click="Close_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Close command mode" AutomationProperties.Name="Close command mode">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                </Button>
            </Grid>

            <TextBlock x:Name="PaletteTitle" Grid.Row="1" Text="What do you want to catch?" Style="{StaticResource PocketTitleText}" FontSize="15" TextWrapping="Wrap" />

            <ScrollViewer x:Name="CommandScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <Grid>
                    <StackPanel x:Name="PrimaryCommands" Spacing="1">
                        <Button x:Name="ScreenshotCommand" Style="{StaticResource CommandRow}" Tag="screenshot" Click="Command_Click">
                            <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="S" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Screenshot" Style="{StaticResource PocketBodyText}" FontSize="13" /><FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="12" Glyph="&#xE76C;" Foreground="{StaticResource PocketMuted}" /></Grid>
                        </Button>
                        <Button Style="{StaticResource CommandRow}" Tag="video" Click="Command_Click">
                            <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="V" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Video" Style="{StaticResource PocketBodyText}" FontSize="13" /><FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="12" Glyph="&#xE714;" Foreground="{StaticResource PocketGreen}" /></Grid>
                        </Button>
                        <Button Style="{StaticResource CommandRow}" Tag="repeat-video" Click="Command_Click">
                            <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="3"><Button Content="⇧" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" AutomationProperties.Name="Shift" ToolTipService.ToolTip="Shift" /><Button Content="V" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Repeat last video" Style="{StaticResource PocketBodyText}" FontSize="13" /></Grid>
                        </Button>
                        <Button Style="{StaticResource CommandRow}" Tag="audio" Click="Command_Click">
                            <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="A" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Audio note" Style="{StaticResource PocketBodyText}" FontSize="13" /><FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="12" Glyph="&#xE720;" Foreground="{StaticResource PocketGreen}" /></Grid>
                        </Button>
                        <Button Style="{StaticResource CommandRow}" Tag="text" Click="Command_Click">
                            <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="T" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Highlighted text" Style="{StaticResource PocketBodyText}" FontSize="13" /><FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="12" Glyph="&#xE8C1;" Foreground="{StaticResource PocketBlue}" /></Grid>
                        </Button>
                        <Button Style="{StaticResource CommandRow}" Tag="link" Click="Command_Click">
                            <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="L" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Current web link" Style="{StaticResource PocketBodyText}" FontSize="13" /><FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="12" Glyph="&#xE71B;" Foreground="{StaticResource PocketBlue}" /></Grid>
                        </Button>
                        <Button Style="{StaticResource CommandRow}" Tag="library" Click="Command_Click">
                            <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="O" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" FontFamily="Segoe UI Variable Display" AutomationProperties.Name="Letter O" ToolTipService.ToolTip="Letter O" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Open Library" Style="{StaticResource PocketBodyText}" FontSize="13" /><FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="12" Glyph="&#xE8B9;" Foreground="{StaticResource PocketMuted}" /></Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="ScreenshotCommands" Visibility="Collapsed" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5"><Button Content="S" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /><FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{StaticResource PocketMuted}" /><TextBlock VerticalAlignment="Center" Text="then one key" Style="{StaticResource PocketCaptionText}" /></StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Button x:Name="RegionCommand" Tag="region" Click="Command_Click" Style="{StaticResource ScreenshotTile}"><StackPanel><TextBlock Text="R" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="14" /><TextBlock Text="Region" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                            <Button Grid.Column="1" Tag="window" Click="Command_Click" Style="{StaticResource ScreenshotTile}"><StackPanel><TextBlock Text="W" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="14" /><TextBlock Text="Window" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                            <Button Grid.Column="2" Tag="display" Click="Command_Click" Style="{StaticResource ScreenshotTile}"><StackPanel><TextBlock Text="D" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="14" /><TextBlock Text="Display" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                            <Button Grid.Row="1" Tag="all-displays" Click="Command_Click" Style="{StaticResource ScreenshotTile}"><StackPanel><TextBlock Text="A" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="14" /><TextBlock Text="All" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                            <Button Grid.Row="1" Grid.Column="1" Tag="previous-region" Click="Command_Click" Style="{StaticResource ScreenshotTile}"><StackPanel><TextBlock Text="P" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="14" /><TextBlock Text="Previous" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                            <Button Grid.Row="1" Grid.Column="2" Tag="back" Click="Command_Click" Style="{StaticResource ScreenshotTile}" Background="Transparent"><StackPanel><TextBlock Text="Esc" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketMuted}" FontSize="12" /><TextBlock Text="Back" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <TextBlock x:Name="PaletteHint" Grid.Row="3" Text="Press one key · Esc closes" Style="{StaticResource PocketCaptionText}" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
