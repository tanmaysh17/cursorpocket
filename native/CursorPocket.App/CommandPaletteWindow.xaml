<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.CommandPaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CursorPocket command mode">
    <Grid x:Name="Root" KeyDown="Root_KeyDown" PointerMoved="Root_PointerMoved" Loaded="Root_Loaded" Background="#FF060D0B">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="S" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="V" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="V" Modifiers="Shift" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="A" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="T" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="L" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="O" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="R" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="W" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="D" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="P" Invoked="CommandAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="CommandAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <Style x:Key="CommandRow" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="CompactKeyCap" TargetType="Button" BasedOn="{StaticResource KeyCapButton}">
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="7,4" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="ScreenshotTile" TargetType="Button">
                <Setter Property="Margin" Value="2" />
                <Setter Property="Padding" Value="8,7" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{StaticResource PocketRaised}" />
            </Style>
            <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" From="0.38" To="0.08" Duration="0:0:1.35" />
                <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.72" To="1.12" Duration="0:0:1.35" />
                <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.72" To="1.12" Duration="0:0:1.35" />
            </Storyboard>
        </Grid.Resources>

        <!-- The frozen desktop the panel covers, offset so command mode reads as a
             quiet pane over the source rather than an opaque box floating on it. -->
        <Image x:Name="BackdropImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Image.RenderTransform>
                <TranslateTransform x:Name="BackdropOffset" />
            </Image.RenderTransform>
        </Image>
        <Rectangle Fill="#F00A1210" IsHitTestVisible="False" />
        <Rectangle Height="64" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#2643E08D" Offset="0" />
                    <GradientStop Color="#0043E08D" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Border BorderBrush="{StaticResource PocketGreen}" BorderThickness="1" CornerRadius="16" Opacity="0.34" IsHitTestVisible="False" />

        <Grid Padding="16,14,16,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="3">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Click="LibraryPulse_Click" ToolTipService.ToolTip="Open the full CursorPocket Library" AutomationProperties.Name="Open the full CursorPocket Library">
                        <Grid Width="28" Height="28">
                            <Ellipse x:Name="PulseRing" Width="26" Height="26" Fill="{StaticResource PocketGreen}" Opacity="0.34" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Image Source="ms-appx:///Assets/CursorPocketLogo.png" Width="26" Height="26" Stretch="Uniform" />
                        </Grid>
                    </Button>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="COMMAND MODE" Foreground="{StaticResource PocketGreen}" FontFamily="Cascadia Mono" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" />
                    <Button Grid.Column="2" VerticalAlignment="Center" Padding="6" Click="Close_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Close command mode" AutomationProperties.Name="Close command mode">
                        <FontIcon Glyph="&#xE711;" FontSize="13" />
                    </Button>
                </Grid>
                <TextBlock x:Name="PaletteTitle" Text="What do you want to catch?" Style="{StaticResource PocketTitleText}" FontSize="18" TextWrapping="Wrap" />
                <TextBlock x:Name="PaletteHint" Text="Press one key. Normal typing is unaffected." Style="{StaticResource PocketCaptionText}" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer x:Name="CommandScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <Grid>
                    <StackPanel x:Name="PrimaryCommands" Spacing="2">
                        <Button x:Name="ScreenshotCommand" Style="{StaticResource CommandRow}" Tag="screenshot" Click="Command_Click">
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="S" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Screenshot" Style="{StaticResource PocketBodyText}" /><TextBlock Text="Region, window, or display" Style="{StaticResource PocketCaptionText}" /></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="13" Glyph="&#xE76C;" Foreground="{StaticResource PocketMuted}" /></Grid>
                        </Button>
                        <Button Style="{StaticResource CommandRow}" Tag="video" Click="Command_Click">
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="V" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Video" Style="{StaticResource PocketBodyText}" /><TextBlock Text="Confirm source and devices first" Style="{StaticResource PocketCaptionText}" /></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="13" Glyph="&#xE714;" Foreground="{StaticResource PocketGreen}" /></Grid>
                        </Button>
                        <Button Style="{StaticResource CommandRow}" Tag="repeat-video" Click="Command_Click">
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="4"><Button Content="Shift" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" FontSize="11" /><TextBlock VerticalAlignment="Center" Text="+" Foreground="{StaticResource PocketMuted}" /><Button Content="V" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Repeat last video setup" Style="{StaticResource PocketBodyText}" /></Grid>
                        </Button>
                        <Button Style="{StaticResource CommandRow}" Tag="audio" Click="Command_Click">
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="A" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Audio note" Style="{StaticResource PocketBodyText}" /><TextBlock x:Name="AudioDeviceHint" Text="Starts with your remembered microphone" Style="{StaticResource PocketCaptionText}" TextTrimming="CharacterEllipsis" /></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="13" Glyph="&#xE720;" Foreground="{StaticResource PocketGreen}" /></Grid>
                        </Button>
                        <Button Style="{StaticResource CommandRow}" Tag="text" Click="Command_Click">
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="T" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Highlighted text" Style="{StaticResource PocketBodyText}" /><TextBlock Text="Only the selection in your last window" Style="{StaticResource PocketCaptionText}" /></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="13" Glyph="&#xE8C1;" Foreground="{StaticResource PocketBlue}" /></Grid>
                        </Button>
                        <Button Style="{StaticResource CommandRow}" Tag="link" Click="Command_Click">
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="L" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Current web link" Style="{StaticResource PocketBodyText}" /><TextBlock Text="Supported browsers only" Style="{StaticResource PocketCaptionText}" /></StackPanel><FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="13" Glyph="&#xE71B;" Foreground="{StaticResource PocketBlue}" /></Grid>
                        </Button>
                        <Button Style="{StaticResource CommandRow}" Tag="library" Click="Command_Click">
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="O" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" FontFamily="Segoe UI Variable Display" AutomationProperties.Name="Letter O" ToolTipService.ToolTip="Letter O" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Open Library" Style="{StaticResource PocketBodyText}" /><FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="13" Glyph="&#xE8B9;" Foreground="{StaticResource PocketMuted}" /></Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="ScreenshotCommands" Visibility="Collapsed" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="S" IsHitTestVisible="False" Style="{StaticResource CompactKeyCap}" /><FontIcon Glyph="&#xE76C;" FontSize="13" Foreground="{StaticResource PocketMuted}" /><TextBlock VerticalAlignment="Center" Text="then one screenshot key" Style="{StaticResource PocketCaptionText}" /></StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Button x:Name="RegionCommand" Tag="region" Click="Command_Click" Style="{StaticResource ScreenshotTile}"><StackPanel><TextBlock Text="R" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="15" /><TextBlock Text="Region" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                            <Button Grid.Column="1" Tag="window" Click="Command_Click" Style="{StaticResource ScreenshotTile}"><StackPanel><TextBlock Text="W" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="15" /><TextBlock Text="Window" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                            <Button Grid.Column="2" Tag="display" Click="Command_Click" Style="{StaticResource ScreenshotTile}"><StackPanel><TextBlock Text="D" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="15" /><TextBlock Text="Display" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                            <Button Grid.Row="1" Tag="all-displays" Click="Command_Click" Style="{StaticResource ScreenshotTile}"><StackPanel><TextBlock Text="A" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="15" /><TextBlock Text="All displays" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                            <Button Grid.Row="1" Grid.Column="1" Tag="previous-region" Click="Command_Click" Style="{StaticResource ScreenshotTile}"><StackPanel><TextBlock Text="P" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketGreen}" FontSize="15" /><TextBlock Text="Previous" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                            <Button Grid.Row="1" Grid.Column="2" Tag="back" Click="Command_Click" Style="{StaticResource ScreenshotTile}" Background="Transparent"><StackPanel><TextBlock Text="Esc" FontFamily="Cascadia Mono" Foreground="{StaticResource PocketMuted}" FontSize="13" /><TextBlock Text="Back" Style="{StaticResource PocketCaptionText}" /></StackPanel></Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="6" Height="6" Fill="{StaticResource PocketGreen}" /><TextBlock Text="Closes after 30 s idle" Style="{StaticResource PocketCaptionText}" /></StackPanel>
                <TextBlock HorizontalAlignment="Right" Text="Esc closes" Style="{StaticResource PocketCaptionText}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
