<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.CompanionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CursorPocket status">
    <Grid Background="Transparent">
        <Button x:Name="CompanionButton" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="CompanionButton_Click" ToolTipService.ToolTip="Open CursorPocket command mode">
            <Grid Width="32" Height="32">
                <Ellipse x:Name="Glow" Width="24" Height="24" Opacity="0.34" Fill="{StaticResource PocketGreenSoft}" />
                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource PocketGreen}" />
            </Grid>
        </Button>
    </Grid>
</Window>
