<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CursorPocket_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CursorPocket_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CursorPocket_App.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Filter pills read as one segmented control, so the selected one is unmistakable.  -->
        <Style x:Key="FilterPill" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Foreground" Value="{ThemeResource PocketMuted}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="ColumnSpacing" Value="14" />
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <!-- The Library is fully keyboard-drivable. These page accelerators never
             affect other applications. General Library actions stand down in text
             boxes; the inline viewer/editor keeps only its own Edit, Save, and Cancel. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Enter" Invoked="OpenAccelerator_Invoked" />
            <KeyboardAccelerator Key="Space" Invoked="PlayAccelerator_Invoked" />
            <KeyboardAccelerator Key="Delete" Invoked="DeleteAccelerator_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="RevealAccelerator_Invoked" />
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="EditAccelerator_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveTextAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="CancelTextEditAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyPathAccelerator_Invoked" />
            <KeyboardAccelerator Key="M" Modifiers="Control" Invoked="MaximizeAccelerator_Invoked" />
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="FilterAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="FilterAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="FilterAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="FilterAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="FilterAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="FilterAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <NavigationView
            x:Name="Navigation"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="LibraryNav" Content="Library" Icon="Pictures" IsSelected="True" Tag="library" />
                <NavigationViewItem x:Name="CaptureNav" Content="Capture" Icon="Camera" Tag="capture" />
                <NavigationViewItem x:Name="SettingsNav" Content="Settings" Icon="Setting" Tag="settings" />
            </NavigationView.MenuItems>

            <Grid>
                <!--  ============================ LIBRARY ============================  -->
                <Grid x:Name="LibraryPanel" Padding="28,22,28,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid VerticalAlignment="Bottom">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource PocketDisplayText}" Text="Everything you caught" />
                            <TextBlock
                                FontSize="13"
                                Style="{StaticResource PocketNumericText}"
                                Text="{x:Bind ViewModel.LibrarySummary, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Click="OpenFolder_Click"
                                Style="{StaticResource PocketQuietButton}"
                                ToolTipService.ToolTip="Open the capture folder in File Explorer">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                                    <TextBlock Text="Capture folder" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenCommand_Click" Style="{StaticResource PocketPrimaryButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE722;" />
                                    <TextBlock Text="New capture" />
                                    <TextBlock
                                        x:Name="NewCaptureShortcut"
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Mono"
                                        FontSize="12"
                                        IsTextScaleFactorEnabled="False"
                                        Opacity="0.62"
                                        Text="" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,0" ColumnSpacing="16">
                        <!--  At the 720 px minimum window there is not enough width for both
                              panes without truncating every title, so the detail pane gives
                              way and the list takes the room. Double-tap still opens a
                              capture, which is the action the pane would have offered.  -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="LibraryNarrow">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="DetailPane.Visibility" Value="Collapsed" />
                                        <Setter Target="DetailColumn.MinWidth" Value="0" />
                                        <Setter Target="DetailColumn.Width" Value="0" />
                                        <Setter Target="ListPane.Margin" Value="0,0,-16,0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="LibraryWide">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="920" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="DetailPane.Visibility" Value="Visible" />
                                        <Setter Target="DetailColumn.MinWidth" Value="308" />
                                        <Setter Target="ListPane.Margin" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <!--  The preview gets almost two thirds of a wide Library. Filters
                                  stay with the list instead of reserving a blank row over the
                                  preview. DetailColumn collapses in the narrow state; preview-only
                                  mode spans DetailPane across both columns.  -->
                            <ColumnDefinition Width="35*" MinWidth="280" />
                            <ColumnDefinition x:Name="DetailColumn" Width="65*" MinWidth="308" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="ListPane">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ScrollViewer
                                Margin="0,0,0,12"
                                HorizontalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <Border
                                    Padding="3"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource PocketSunken}"
                                    BorderBrush="{ThemeResource PocketLine}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel x:Name="FilterBar" Orientation="Horizontal" Spacing="2">
                                        <Button Click="Filter_Click" Style="{StaticResource FilterPill}" Tag="All">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="All" />
                                                <TextBlock Style="{StaticResource PocketNumericText}" FontSize="11" Text="{x:Bind ViewModel.AllCount, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="Filter_Click" Style="{StaticResource FilterPill}" Tag="Screenshots">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="Screenshots" />
                                                <TextBlock Style="{StaticResource PocketNumericText}" FontSize="11" Text="{x:Bind ViewModel.ScreenshotCount, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="Filter_Click" Style="{StaticResource FilterPill}" Tag="Video">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="Video" />
                                                <TextBlock Style="{StaticResource PocketNumericText}" FontSize="11" Text="{x:Bind ViewModel.VideoCount, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="Filter_Click" Style="{StaticResource FilterPill}" Tag="Audio">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="Audio" />
                                                <TextBlock Style="{StaticResource PocketNumericText}" FontSize="11" Text="{x:Bind ViewModel.AudioCount, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="Filter_Click" Style="{StaticResource FilterPill}" Tag="Text">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="Text" />
                                                <TextBlock Style="{StaticResource PocketNumericText}" FontSize="11" Text="{x:Bind ViewModel.TextCount, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="Filter_Click" Style="{StaticResource FilterPill}" Tag="Links">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="Links" />
                                                <TextBlock Style="{StaticResource PocketNumericText}" FontSize="11" Text="{x:Bind ViewModel.LinkCount, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>

                            <Border Grid.Row="1" Style="{StaticResource PocketCard}">
                                <Grid>
                                <ListView
                                    x:Name="CaptureList"
                                    Padding="6"
                                    IsItemClickEnabled="False"
                                    DoubleTapped="CaptureList_DoubleTapped"
                                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                                    SelectionChanged="CaptureList_SelectionChanged"
                                    SelectionMode="Extended">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="46" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CaptureItemViewModel">
                                            <Grid MinHeight="46" Padding="6,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!--  The capture itself wherever one can be rendered. The kind
                                                      icon sits underneath as the fallback: it shows while the
                                                      thumbnail loads, and stays for text and links.  -->
                                                <Border
                                                    Width="52"
                                                    Height="34"
                                                    Background="{ThemeResource PocketSunken}"
                                                    CornerRadius="7">
                                                    <Grid>
                                                        <FontIcon
                                                            FontSize="14"
                                                            Foreground="{ThemeResource PocketGreen}"
                                                            Glyph="{x:Bind IconGlyph}" />
                                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="1">
                                                    <TextBlock
                                                        Style="{StaticResource PocketBodyText}"
                                                        Text="{x:Bind Preview}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <!--  Kind and size on one line, so the row stays a strip
                                                          instead of the four columns this replaced.  -->
                                                    <TextBlock Style="{StaticResource PocketMetaText}" Text="{x:Bind MetaLabel}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource PocketNumericText}"
                                                    Text="{x:Bind TimeLabel}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <StackPanel x:Name="LoadingLibrary" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="Collapsed">
                                    <ProgressRing Width="28" Height="28" HorizontalAlignment="Center" IsActive="True" />
                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource PocketCaptionText}" Text="Loading your captures…" />
                                </StackPanel>

                                <StackPanel x:Name="LibraryError" MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="Collapsed">
                                    <FontIcon HorizontalAlignment="Center" FontSize="26" Foreground="{ThemeResource PocketRed}" Glyph="&#xE783;" />
                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource PocketTitleText}" Text="The library could not open" />
                                    <TextBlock MaxWidth="340" HorizontalAlignment="Center" Style="{StaticResource PocketCaptionText}" Text="Your capture index could not be read. Your capture files have not been changed." TextAlignment="Center" TextWrapping="Wrap" />
                                    <Button HorizontalAlignment="Center" Click="RetryLibrary_Click" Content="Try again" Style="{StaticResource PocketPrimaryButton}" />
                                </StackPanel>

                                <StackPanel
                                    x:Name="EmptyLibrary"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="14">
                                    <Path
                                        Width="26"
                                        Height="37"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource PocketCursorMark}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource PocketTitleText}"
                                        Text="Your pocket is ready" />
                                    <TextBlock
                                        MaxWidth="340"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource PocketCaptionText}"
                                        Text="{x:Bind ViewModel.ActivationHint, Mode=OneWay}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <Button
                                        HorizontalAlignment="Center"
                                        Click="OpenCommand_Click"
                                        Content="Make the first capture"
                                        Style="{StaticResource PocketPrimaryButton}" />
                                </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border
                            x:Name="DetailPane"
                            Grid.Column="1"
                            Style="{StaticResource PocketCard}">
                            <Grid Padding="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!--  The header carries the maximize toggle: the preview is the
                                      reason this pane exists, so filling the window with it is one
                                      click (or Ctrl+M) away.  -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="DetailKind" Style="{StaticResource PocketLabelText}" Text="Capture preview" />
                                        <TextBlock
                                            x:Name="DetailTitle"
                                            MaxLines="1"
                                            Style="{StaticResource PocketSubtitleText}"
                                            Text="Choose something from your library"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <Button
                                        x:Name="MaximizePreviewButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Click="MaximizePreview_Click"
                                        Style="{StaticResource PocketIconButton}"
                                        ToolTipService.ToolTip="Fill the window with the preview · Ctrl+M"
                                        AutomationProperties.Name="Fill the window with the preview">
                                        <FontIcon x:Name="MaximizePreviewIcon" FontSize="14" Glyph="&#xE740;" />
                                    </Button>
                                </Grid>
                                <Border
                                    x:Name="DetailWell"
                                    Grid.Row="1"
                                    Margin="0,10,0,8"
                                    MinHeight="0"
                                    Style="{StaticResource PocketWell}">
                                    <Grid>
                                        <Image
                                            x:Name="DetailImage"
                                            Margin="4"
                                            Stretch="Uniform"
                                            Visibility="Collapsed" />
                                        <!--  Compact mode preserves the full transport set while turning
                                              WinUI's 96 px two-storey panel into a 48 px overlay.  -->
                                        <MediaPlayerElement
                                            x:Name="DetailPlayer"
                                            AreTransportControlsEnabled="True"
                                            AutoPlay="False"
                                            Stretch="Uniform"
                                            Visibility="Collapsed">
                                            <MediaPlayerElement.TransportControls>
                                                <MediaTransportControls
                                                    Margin="0"
                                                    IsCompact="True"
                                                    IsFastForwardButtonVisible="True"
                                                    IsFastForwardEnabled="True"
                                                    IsFastRewindButtonVisible="True"
                                                    IsFastRewindEnabled="True"
                                                    IsPlaybackRateButtonVisible="True"
                                                    IsPlaybackRateEnabled="True"
                                                    IsRepeatButtonVisible="True"
                                                    IsRepeatEnabled="True"
                                                    IsSeekBarVisible="True"
                                                    IsSeekEnabled="True"
                                                    IsSkipBackwardButtonVisible="True"
                                                    IsSkipBackwardEnabled="True"
                                                    IsSkipForwardButtonVisible="True"
                                                    IsSkipForwardEnabled="True"
                                                    IsVolumeButtonVisible="True"
                                                    IsVolumeEnabled="True"
                                                    IsZoomButtonVisible="True"
                                                    IsZoomEnabled="True"
                                                    ShowAndHideAutomatically="True" />
                                            </MediaPlayerElement.TransportControls>
                                        </MediaPlayerElement>
                                        <StackPanel
                                            x:Name="DetailTextPanel"
                                            Margin="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="12">
                                            <FontIcon
                                                x:Name="DetailIcon"
                                                FontSize="24"
                                                Foreground="{ThemeResource PocketMuted}"
                                                Glyph="&#xE7C3;" />
                                            <TextBlock
                                                x:Name="DetailText"
                                                MaxWidth="300"
                                                MaxLines="6"
                                                Style="{StaticResource PocketCaptionText}"
                                                Text="Screenshots, waveforms, and video posters appear here."
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <!--  Text is content, not a file-shaped placeholder. Keep it selectable
                                              and scrollable here; Edit changes this same control in place.  -->
                                        <TextBox
                                            x:Name="DetailTextEditor"
                                            Margin="8"
                                            Padding="16"
                                            AcceptsReturn="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontFamily="Segoe UI Variable Text"
                                            FontSize="14"
                                            Foreground="{ThemeResource PocketInk}"
                                            IsReadOnly="True"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Text capture contents" />
                                    </Grid>
                                </Border>

                                <Grid x:Name="DetailFacts" Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Style="{StaticResource PocketMetaText}" Text="Kind" />
                                            <TextBlock x:Name="FactKind" Style="{StaticResource PocketNumericText}" Text="—" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                            <TextBlock Style="{StaticResource PocketMetaText}" Text="Size" />
                                            <TextBlock x:Name="FactSize" Style="{StaticResource PocketNumericText}" Text="—" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                            <TextBlock Style="{StaticResource PocketMetaText}" Text="Saved" />
                                            <TextBlock x:Name="FactSaved" Style="{StaticResource PocketNumericText}" Text="—" />
                                        </StackPanel>
                                        <Grid Grid.Column="3" ColumnSpacing="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource PocketMetaText}" Text="File" />
                                            <TextBlock x:Name="FactFile" Grid.Column="1" Style="{StaticResource PocketNumericText}" Text="—" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <StackPanel x:Name="DefaultActions" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="OpenButton" Click="Open_Click" Content="Open" Style="{StaticResource PocketPrimaryButton}" />
                                            <Button Command="{x:Bind ViewModel.RevealSelectedCommand}" Content="Reveal" Style="{StaticResource PocketQuietButton}" />
                                            <Button x:Name="EditButton" Click="Edit_Click" Content="Mark up" Style="{StaticResource PocketQuietButton}" ToolTipService.ToolTip="Ctrl+E — saves an edited copy and leaves this one alone" />
                                            <Button Click="CopyPath_Click" Style="{StaticResource PocketIconButton}" ToolTipService.ToolTip="Copy file path">
                                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel x:Name="TextEditActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                            <Button x:Name="SaveTextButton" Click="SaveText_Click" Content="Save" Style="{StaticResource PocketPrimaryButton}" ToolTipService.ToolTip="Save text changes · Ctrl+S" />
                                            <Button Click="CancelTextEdit_Click" Content="Cancel" Style="{StaticResource PocketQuietButton}" ToolTipService.ToolTip="Discard text changes · Escape" />
                                        </StackPanel>
                                        <Button
                                            x:Name="DeleteButton"
                                            HorizontalAlignment="Right"
                                            Click="DeleteSelected_Click"
                                            Style="{StaticResource PocketDangerIconButton}"
                                            ToolTipService.ToolTip="Move to Recycle Bin"
                                            AutomationProperties.Name="Move selected captures to the Recycle Bin">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                <TextBlock x:Name="DeleteCountText" Visibility="Collapsed" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,14,0,0" ColumnSpacing="8">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Ellipse
                                x:Name="LibraryStatusDot"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource PocketGreen}" />
                            <TextBlock
                                x:Name="LibraryStatusText"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource PocketMetaText}"
                                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource PocketNumericText}"
                            Text="{x:Bind ViewModel.CaptureDirectory, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>

                <!--  ============================ CAPTURE ============================  -->
                <ScrollViewer x:Name="CapturePanel" Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="1040"
                        Padding="28,22,28,32"
                        HorizontalAlignment="Stretch"
                        Spacing="22">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource PocketDisplayText}" Text="Catch it while it matters" />
                            <TextBlock
                                MaxWidth="580"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PocketCaptionText}"
                                Text="The complete command catalogue is available here and in command mode, with the same mnemonic keys."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button
                                x:Name="ScreenshotTile"
                                MinHeight="132"
                                Click="ScreenshotTile_Click"
                                Style="{StaticResource PocketTileButton}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border MinWidth="40" Height="40" HorizontalAlignment="Left" Style="{StaticResource PocketKeycap}">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Style="{StaticResource PocketNumericText}" Text="S" />
                                    </Border>
                                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                        <TextBlock Style="{StaticResource PocketSubtitleText}" Text="Screenshot" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Style="{StaticResource PocketCaptionText}"
                                            Text="Region, window, one display, or all of them"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button
                                x:Name="VideoTile"
                                Grid.Column="1"
                                MinHeight="132"
                                Click="VideoTile_Click"
                                Style="{StaticResource PocketTileButton}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border MinWidth="40" Height="40" HorizontalAlignment="Left" Style="{StaticResource PocketKeycap}">
