<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CursorPocket_App.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:CursorPocket.Core.Models"
    xmlns:services="using:CursorPocket.Core.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="TourStepButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="TourCommandButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
            <Setter Property="MinHeight" Value="43" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource PocketLine}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="StarterTaskButton" TargetType="Button" BasedOn="{StaticResource PocketButtonBase}">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource PocketRaised}" />
            <Setter Property="BorderBrush" Value="{ThemeResource PocketLine}" />
        </Style>
    </Page.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Grid
            x:Name="TourLayout"
            MaxWidth="1160"
            MinHeight="560"
            Padding="32,24,32,32"
            HorizontalAlignment="Center"
            ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TourRail" Spacing="22">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" Style="{StaticResource PocketChipLarge}">
                            <Path Width="11" Height="16" Style="{StaticResource PocketCursorMark}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource PocketSubtitleText}" Text="CursorPocket" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource PocketMetaText}" Text="One-minute field guide" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <Button x:Name="WelcomeStepButton" Tag="0" Click="Step_Click" Style="{StaticResource TourStepButton}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="WelcomeStepMark" Width="22" Height="22" CornerRadius="11" BorderThickness="1">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Style="{StaticResource PocketNumericText}" Text="1" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource PocketBodyStrongText}" Text="The capture loop" />
                                <TextBlock Style="{StaticResource PocketMetaText}" Text="Capture, shape, retrieve" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Rectangle Width="1" Height="10" Margin="25,0,0,0" HorizontalAlignment="Left" Fill="{ThemeResource PocketLine}" />
                    <Button x:Name="ActivateStepButton" Tag="1" Click="Step_Click" Style="{StaticResource TourStepButton}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="ActivateStepMark" Width="22" Height="22" CornerRadius="11" BorderThickness="1">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Style="{StaticResource PocketNumericText}" Text="2" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource PocketBodyStrongText}" Text="Command mode" />
                                <TextBlock Style="{StaticResource PocketMetaText}" Text="All seven actions" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Rectangle Width="1" Height="10" Margin="25,0,0,0" HorizontalAlignment="Left" Fill="{ThemeResource PocketLine}" />
                    <Button x:Name="RehearseStepButton" Tag="2" Click="Step_Click" Style="{StaticResource TourStepButton}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="RehearseStepMark" Width="22" Height="22" CornerRadius="11" BorderThickness="1">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Style="{StaticResource PocketNumericText}" Text="3" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource PocketBodyStrongText}" Text="First capture" />
                                <TextBlock Style="{StaticResource PocketMetaText}" Text="A real useful result" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="4">
                    <Button
                        MinHeight="40"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Skip the welcome tour"
                        Click="Skip_Click"
                        Content="Skip tour"
                        Style="{StaticResource PocketGhostButton}" />
                    <TextBlock MaxWidth="210" Style="{StaticResource PocketMetaText}" Text="You can run it again from Settings." TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <Grid x:Name="TourContent" Grid.Column="1" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    MaxWidth="720"
                    HorizontalAlignment="Left"
                    AutomationProperties.LiveSetting="Polite"
                    Spacing="7">
                    <TextBlock x:Name="StepEyebrow" Style="{StaticResource PocketMetaText}" />
                    <TextBlock x:Name="StepTitle" Style="{StaticResource PocketDisplayText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="StepDescription" MaxWidth="680" Style="{StaticResource PocketCaptionText}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- The tour owns one instrument. Its contents change with the task,
                     while the Acrylic backdrop and field frame remain stable. -->
                <Border
                    Grid.Row="1"
                    MinHeight="382"
                    Background="{ThemeResource PocketGlassPanel}"
                    BorderBrush="{ThemeResource PocketLineStrong}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid>
                        <Grid x:Name="WelcomeField" Padding="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="224" />
                            </Grid.ColumnDefinitions>

                            <ItemsControl ItemsSource="{x:Bind CapabilityStages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:OnboardingCapabilityStageDescriptor">
                                        <Grid MinHeight="104" Padding="0,8" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="42" Height="42" VerticalAlignment="Top">
                                                <Ellipse Stroke="{ThemeResource PocketLineStrong}" StrokeThickness="1" />
                                                <FontIcon FontSize="16" Foreground="{ThemeResource PocketInkDim}" Glyph="{x:Bind Glyph}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Style="{StaticResource PocketNumericText}" Text="{x:Bind Number}" />
                                                    <TextBlock Style="{StaticResource PocketLabelText}" Text="{x:Bind Label}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource PocketBodyStrongText}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource PocketCaptionText}" Text="{x:Bind Description}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource PocketMetaText}" Text="{x:Bind Examples}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Rectangle Grid.Column="1" Margin="0,4" Fill="{ThemeResource PocketLine}" />

                            <StackPanel Grid.Column="2" Margin="22,4,0,4" VerticalAlignment="Center" Spacing="18">
                                <StackPanel Spacing="5">
                                    <TextBlock Style="{StaticResource PocketLabelText}" Text="LOCAL BY DESIGN" />
                                    <TextBlock Style="{StaticResource PocketSubtitleText}" Text="Nothing is uploaded." />
                                    <TextBlock Style="{StaticResource PocketCaptionText}" Text="No account, cloud service, analytics, or remote AI. OCR and capture processing stay on this PC." TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="9">
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Fill="{ThemeResource PocketGreen}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource PocketCaptionText}" Text="Green means ready or saved" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Fill="{ThemeResource PocketRed}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource PocketCaptionText}" Text="Red means recording or discard" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource PocketMetaText}" Text="Your capture folder" />
                                    <TextBlock x:Name="WelcomeFolderPathText" MaxLines="2" Style="{StaticResource PocketNumericText}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ActivationField" Padding="22" Visibility="Collapsed" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="226" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="16">
                                <StackPanel Spacing="7">
                                    <TextBlock Style="{StaticResource PocketLabelText}" Text="PRIMARY ACTIVATION" />
                                    <Border Padding="14,11" Background="{ThemeResource PocketGreenSoft}" BorderBrush="{ThemeResource PocketGreen}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel Spacing="5">
                                            <TextBlock Style="{StaticResource PocketMetaText}" Text="From any app" />
                                            <TextBlock x:Name="ShortcutText" FontSize="14" Foreground="{ThemeResource PocketInk}" Style="{StaticResource PocketNumericText}" Text="Ctrl+Shift+Space" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="ShortcutStatus" Style="{StaticResource PocketCaptionText}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="9">
                                    <TextBlock Style="{StaticResource PocketLabelText}" Text="POINTER OPTIONS" />
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid Width="28" Height="28">
                                            <Ellipse Width="24" Height="24" Stroke="{ThemeResource PocketLineStrong}" StrokeThickness="1" />
                                            <Ellipse Width="14" Height="14" Stroke="{ThemeResource PocketLineStrong}" StrokeThickness="1" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PocketCaptionText}" Text="Draw two circles" />
                                        <TextBlock x:Name="GestureStatusText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource PocketMetaText}" />
                                    </Grid>
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <FontIcon FontSize="16" Foreground="{ThemeResource PocketInkDim}" Glyph="&#xE962;" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PocketCaptionText}" Text="Hold both mouse buttons" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ChordStatusText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource PocketMetaText}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Style="{StaticResource PocketLabelText}" Text="CURSOR COMPANION" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource PocketGreen}" />
                                        <TextBlock x:Name="CompanionStatusText" VerticalAlignment="Center" Style="{StaticResource PocketCaptionText}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Fill="{ThemeResource PocketLine}" />

                            <Grid Grid.Column="2" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Style="{StaticResource PocketLabelText}" Text="THE ACTUAL ROOT MENU" />
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource PocketMetaText}" Text="Keys work without focus" />
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Commands}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:CaptureActionDescriptor">
                                            <Button
                                                AutomationProperties.HelpText="Select to learn what happens after this command"
                                                Click="CommandPreview_Click"
                                                Style="{StaticResource TourCommandButton}"
                                                Tag="{x:Bind Id}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions>
                                                    <Border Width="64" Height="27" Padding="5,0" HorizontalAlignment="Left" Style="{StaticResource PocketChip}">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Style="{StaticResource PocketNumericText}" Text="{x:Bind Key}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PocketBodyStrongText}" Text="{x:Bind Title}" />
                                                    <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource PocketInkDim}" Glyph="{x:Bind Glyph}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Grid.Row="2" Padding="10,8,10,0" BorderBrush="{ThemeResource PocketLine}" BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock x:Name="CommandPreviewTitle" Style="{StaticResource PocketBodyStrongText}" />
                                        <TextBlock x:Name="CommandPreviewDescription" Style="{StaticResource PocketCaptionText}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="CommandPreviewFollowUp" Style="{StaticResource PocketMetaText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid x:Name="RehearsalField" Padding="22" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="286" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,22,0" Spacing="12">
                                <TextBlock Style="{StaticResource PocketLabelText}" Text="CHOOSE A FIRST WIN" />
                                <Button x:Name="ScreenshotStarterButton" Tag="Screenshot" Click="StarterTask_Click" Style="{StaticResource StarterTaskButton}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="36" Style="{StaticResource PocketChipLarge}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PocketNumericText}" Text="S" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Style="{StaticResource PocketBodyStrongText}" Text="Screenshot" />
                                            <TextBlock Style="{StaticResource PocketMetaText}" Text="Capture a region, then shape it" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource PocketInkDim}" Glyph="&#xE91B;" />
                                    </Grid>
                                </Button>
                                <Button x:Name="VideoStarterButton" Tag="Video" Click="StarterTask_Click" Style="{StaticResource StarterTaskButton}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="36" Style="{StaticResource PocketChipLarge}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PocketNumericText}" Text="V" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Style="{StaticResource PocketBodyStrongText}" Text="Video" />
                                            <TextBlock Style="{StaticResource PocketMetaText}" Text="Set screen, mic, and camera first" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource PocketInkDim}" Glyph="&#xE714;" />
                                    </Grid>
                                </Button>
                                <Button x:Name="AudioStarterButton" Tag="Audio" Click="StarterTask_Click" Style="{StaticResource StarterTaskButton}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="36" Style="{StaticResource PocketChipLarge}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PocketNumericText}" Text="A" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Style="{StaticResource PocketBodyStrongText}" Text="Audio note" />
                                            <TextBlock Style="{StaticResource PocketMetaText}" Text="Start talking, then Escape to save" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource PocketInkDim}" Glyph="&#xE720;" />
                                    </Grid>
                                </Button>

                                <Border Padding="12,10" Background="{ThemeResource PocketSunken}" CornerRadius="10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="StarterKeySequenceText" MinWidth="74" VerticalAlignment="Center" Foreground="{ThemeResource PocketInk}" Style="{StaticResource PocketNumericText}" />
                                        <TextBlock x:Name="StarterInstructionText" Grid.Column="1" Style="{StaticResource PocketCaptionText}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Fill="{ThemeResource PocketLine}" />

                            <StackPanel Grid.Column="2" Margin="22,0,0,0" Spacing="15">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource PocketLabelText}" Text="KEEP IT CLOSE" />
                                    <TextBlock Style="{StaticResource PocketBodyStrongText}" Text="CursorPocket can stay quiet between captures." TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <CheckBox
                                        x:Name="StartWithWindowsCheckBox"
                                        MinHeight="40"
                                        AutomationProperties.HelpText="CursorPocket starts hidden in the notification area."
                                        Content="Start when I sign in" />
                                    <CheckBox
                                        x:Name="ShowCompanionCheckBox"
                                        MinHeight="40"
                                        AutomationProperties.HelpText="Shows the small ready indicator beside the pointer."
                                        Content="Show the cursor companion" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Style="{StaticResource PocketMetaText}" Text="Capture folder" />
                                    <TextBlock x:Name="RehearsalFolderPathText" MaxLines="2" Style="{StaticResource PocketNumericText}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                    <Button
                                        MinHeight="36"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Open the local capture folder"
                                        Click="OpenFolder_Click"
                                        Content="Open folder"
                                        Style="{StaticResource PocketQuietButton}" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="{ThemeResource PocketGreen}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource PocketCaptionText}" Text="Ready. Nothing is captured until you choose an action." TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Button x:Name="BackButton" MinHeight="40" HorizontalAlignment="Left" Click="Back_Click" Content="Back" Style="{StaticResource PocketGhostButton}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="FinalFinishButton"
                            MinHeight="44"
                            Click="FinishForNow_Click"
                            Content="Finish for now"
                            Style="{StaticResource PocketQuietButton}"
                            Visibility="Collapsed" />
                        <Button x:Name="NextButton" MinHeight="44" Click="Next_Click" Content="Continue" Style="{StaticResource PocketPrimaryButton}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RailColumn.Width" Value="0" />
                            <Setter Target="TourRail.Visibility" Value="Collapsed" />
                            <Setter Target="TourContent.(Grid.Column)" Value="0" />
                            <Setter Target="TourContent.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="TourLayout.Padding" Value="24,20,24,28" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="940" />
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ScrollViewer>
</Page>
