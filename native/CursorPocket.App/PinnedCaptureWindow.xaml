<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.PinnedCaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pinned screenshot">
    <!--  Opaque edge to edge with no transparent root gutter: that gutter is what put a
          white frame around the HUD and the receipt. Rounded corners come from DWM rather
          than a window region, because a region takes the window off DWM's fast path and
          this is a window the user drags.  -->
    <Grid
        x:Name="Root"
        Background="{ThemeResource PocketBase}"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited"
        PointerMoved="Root_PointerMoved"
        PointerPressed="Root_PointerPressed"
        PointerReleased="Root_PointerReleased"
        PointerCaptureLost="Root_PointerCaptureLost"
        PointerWheelChanged="Root_PointerWheelChanged">
        <!--  Escape closes only while the pin has focus, as a page accelerator. It must
              never take a scoped global Escape lease: a pin can sit on screen for hours
              while the user works elsewhere, and holding the topmost lease would steal
              Escape from every other application — including a recording, where Escape
              means stop and save.  -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Image
            x:Name="PinImage"
            Stretch="Uniform"
            AutomationProperties.Name="Pinned screenshot" />

        <!--  Controls appear only on hover, at the bottom rather than the top: a
              screenshot's own content usually starts at its top-left, and covering that is
              what makes a floating thumbnail useless.  -->
        <Grid
            x:Name="ControlStrip"
            Height="36"
            Margin="8"
            VerticalAlignment="Bottom"
            Opacity="0">
            <Border
                Background="{ThemeResource PocketRaised}"
                BorderBrush="{ThemeResource PocketLine}"
                BorderThickness="1"
                CornerRadius="10" />
            <Grid Padding="6,0">
                <!--  A separate, wider element from the body: CanDrag competes with the
                      window-move drag, which is exactly why the reference tool gives the
                      file-drag its own handle.  -->
                <Border
                    x:Name="DragHandle"
                    Width="44"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    CanDrag="True"
                    DragStarting="DragHandle_DragStarting"
                    AutomationProperties.Name="Drag this screenshot out as a file"
                    ToolTipService.ToolTip="Drag out as a file">
                    <Path
                        Width="24"
                        Height="24"
                        Data="M6,9 H18 M6,12 H18 M6,15 H18"
                        Stretch="None"
                        Stroke="{ThemeResource PocketMuted}"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="2" />
                </Border>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        Click="Edit_Click"
                        Style="{StaticResource PocketIconButton}"
                        AutomationProperties.Name="Mark up this screenshot"
                        ToolTipService.ToolTip="Mark up">
                        <FontIcon FontSize="12" Glyph="&#xE70F;" />
                    </Button>
                    <Button
                        Click="CopyPath_Click"
                        Style="{StaticResource PocketIconButton}"
                        AutomationProperties.Name="Copy the file path"
                        ToolTipService.ToolTip="Copy file path">
                        <TextBlock Style="{StaticResource PocketTagText}" Text="PATH" />
                    </Button>
                    <Button
                        Click="Copy_Click"
                        Style="{StaticResource PocketIconButton}"
                        AutomationProperties.Name="Copy this screenshot"
                        ToolTipService.ToolTip="Copy image · Ctrl+C">
                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                    </Button>
                    <Button
                        Click="Close_Click"
                        Style="{StaticResource PocketIconButton}"
                        AutomationProperties.Name="Close this pin"
                        ToolTipService.ToolTip="Close · Esc or middle-click">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

