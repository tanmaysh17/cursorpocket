<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.ReceiptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Capture saved">
    <!--  Opaque and strokeless for the same reason as the HUD: the rounded region is cut
          by the window itself, so a border would leave an artefact behind it.  -->
    <Grid
        Background="#FF141E1A"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited">
        <Border
            Padding="14"
            Background="#FF141E1A"
            BorderThickness="0"
            CornerRadius="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="68"
                    Height="68"
                    VerticalAlignment="Top"
                    Background="#FF0A120F"
                    CornerRadius="10">
                    <Grid>
                        <Image
                            x:Name="PreviewImage"
                            Stretch="UniformToFill"
                            Visibility="Collapsed" />
                        <FontIcon
                            x:Name="ReceiptIcon"
                            FontSize="22"
                            Foreground="{StaticResource PocketGreen}"
                            Glyph="&#xE73E;" />
                    </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Name="ReceiptTitle"
                            MaxWidth="252"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PocketBodyStrongText}"
                            Text="Capture saved"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="ReceiptDetail"
                            MaxWidth="252"
                            Style="{StaticResource PocketNumericText}"
                            Text="Saved locally"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button
                            x:Name="OpenButton"
                            MinHeight="32"
                            Click="Open_Click"
                            Content="Open"
                            Style="{StaticResource PocketPrimaryButton}" />
                        <Button
                            x:Name="RevealButton"
                            MinHeight="32"
                            Click="Reveal_Click"
                            Content="Reveal"
                            Style="{StaticResource PocketQuietButton}" />
                        <Button
                            MinHeight="32"
                            Click="Library_Click"
                            Content="Library"
                            Style="{StaticResource PocketGhostButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <!-- Hovering pauses the auto-close timer, so the receipt needs an explicit
             way out rather than only the 12 second countdown. -->
        <Button x:Name="DismissButton" Click="Dismiss_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Width="26" Height="26" Padding="0" CornerRadius="8" Background="#FF1B2723" BorderThickness="0" ToolTipService.ToolTip="Dismiss" AutomationProperties.Name="Dismiss this receipt">
            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource PocketMuted}" />
        </Button>
    </Grid>
</Window>
