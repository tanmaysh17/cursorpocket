<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.ReceiptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Capture saved">
    <Grid
        x:Name="Root"
        Background="{ThemeResource PocketTransientSurface}"
        KeyDown="Root_KeyDown"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited">
        <Border Padding="16" Background="{ThemeResource PocketTransientSurface}" CornerRadius="16">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="72" Height="72" VerticalAlignment="Top" Background="{ThemeResource PocketSunken}" CornerRadius="10">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="UniformToFill" Visibility="Collapsed" />
                        <FontIcon x:Name="ReceiptIcon" FontSize="22" Foreground="{ThemeResource PocketGreen}" Glyph="&#xE73E;" />
                    </Grid>
                </Border>
                <Grid Grid.Column="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ReceiptTitle" MaxWidth="300" Style="{StaticResource PocketBodyStrongText}" Text="Capture saved" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ReceiptDetail" Grid.Row="1" MaxWidth="300" Style="{StaticResource PocketCaptionText}" Text="Saved locally" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="OpenButton" Click="Open_Click" Content="Open" Style="{StaticResource PocketPrimaryButton}" />
                        <Button x:Name="EditButton" Click="Edit_Click" Content="Mark up" Style="{StaticResource PocketQuietButton}" />
                        <Button x:Name="RevealButton" Click="Reveal_Click" Content="Show in folder" Style="{StaticResource PocketGhostButton}" />
                    </StackPanel>
                </Grid>
                <Button
                    x:Name="DismissButton"
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Click="Dismiss_Click"
                    Style="{StaticResource PocketIconButton}"
                    ToolTipService.ToolTip="Dismiss · Esc"
                    AutomationProperties.Name="Dismiss receipt">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

