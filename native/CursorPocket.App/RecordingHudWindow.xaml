<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.RecordingHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recording">
    <!--  Opaque throughout: separation comes from the fill and the clipped corners, never
          from a stroke, so no DWM border can survive on top of captured content.  -->
    <Grid Background="#FF09110F">
        <Border
            Padding="22,0"
            Background="#FF09110F"
            BorderThickness="0"
            CornerRadius="20">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="36" Height="36">
                    <Ellipse Fill="#33FF5F6B" />
                    <Ellipse
                        Width="12"
                        Height="12"
                        Fill="{StaticResource PocketRed}" />
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <TextBlock
                        x:Name="ModeText"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Recording" />
                    <TextBlock
                        x:Name="DeviceText"
                        MaxWidth="230"
                        FontSize="13"
                        Foreground="#FFA9B7B1"
                        Text="Microphone"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Spacing="9">
                    <TextBlock
                        x:Name="TimerText"
                        FontFamily="Cascadia Mono"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="White"
                        IsTextScaleFactorEnabled="False"
                        Text="0:00" />
                    <ProgressBar
                        x:Name="LevelBar"
                        Height="6"
                        Background="#FF25332D"
                        Foreground="{StaticResource PocketGreen}"
                        Maximum="1"
                        Minimum="0" />
                </StackPanel>

                <Button
                    x:Name="StopButton"
                    Grid.Column="4"
                    MinWidth="124"
                    Height="44"
                    Click="Stop_Click"
                    Content="Stop &amp; save"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Style="{StaticResource PocketPrimaryButton}"
                    AutomationProperties.Name="Stop and save recording" />
                <Button
                    x:Name="DiscardButton"
                    Grid.Column="5"
                    Width="44"
                    Height="44"
                    Padding="0"
                    Background="#29FF5F6B"
                    BorderThickness="0"
                    Click="Discard_Click"
                    CornerRadius="12"
                    Foreground="{StaticResource PocketRed}"
                    Style="{StaticResource PocketDangerButton}"
                    ToolTipService.ToolTip="Discard recording"
                    AutomationProperties.Name="Discard recording">
                    <FontIcon FontSize="15" Glyph="&#xE74D;" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
