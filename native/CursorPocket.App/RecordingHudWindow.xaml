<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.RecordingHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recording">
    <!-- The window is a fixed size and slides vertically, mostly off the top of the
         screen when closed. Nothing resizes and no window region is recomputed, which
         is what keeps the travel smooth: both of those force a full redraw per frame. -->
    <Grid x:Name="Root" Background="#FF09110F" PointerEntered="Root_PointerEntered" PointerExited="Root_PointerExited" GotFocus="Root_GotFocus" LostFocus="Root_LostFocus">
        <!-- Closed: only this strip, at the bottom of the window, is on screen. -->
        <Grid x:Name="CollapsedView" Height="32" VerticalAlignment="Bottom" Padding="12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="CollapsedDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource PocketRed}" />
            <TextBlock x:Name="CollapsedTimerText" Grid.Column="1" VerticalAlignment="Center" Text="0:00" FontFamily="Cascadia Mono" FontSize="12" Foreground="White" />
            <StackPanel x:Name="CollapsedMeter" Grid.Column="2" Orientation="Horizontal" Height="14" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2" />
        </Grid>

        <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0" Padding="13,11" RowSpacing="9">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ExpandedSlide" Y="-10" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Ellipse Fill="#55FF5A67" />
                    <Ellipse Width="7" Height="7" Fill="{StaticResource PocketRed}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeText" Text="Recording" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DeviceText" Text="Microphone" FontSize="10" Foreground="#B3F4FAF7" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="TimerText" Grid.Column="2" VerticalAlignment="Center" Text="0:00" FontFamily="Cascadia Mono" FontSize="15" FontWeight="SemiBold" Foreground="White" />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ExpandedMeter" Orientation="Horizontal" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="2" />
                <Button x:Name="StopButton" Grid.Column="1" MinWidth="78" Height="28" Padding="0" Click="Stop_Click" Content="Stop &amp; save" BorderThickness="0" FontSize="12" FontWeight="SemiBold" CornerRadius="8" Style="{StaticResource PocketPrimaryButton}" AutomationProperties.Name="Stop and save recording" />
                <Button x:Name="DiscardButton" Grid.Column="2" Width="28" Height="28" Padding="0" Click="Discard_Click" Background="#32FF5A67" BorderThickness="0" CornerRadius="8" ToolTipService.ToolTip="Discard recording" AutomationProperties.Name="Discard recording">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{StaticResource PocketRed}" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
