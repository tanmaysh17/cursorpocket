<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.RecordingHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recording">
    <!-- The window is a fixed size and slides vertically, mostly off the top of the
         screen when closed. Nothing resizes and no window region is recomputed, which
         is what keeps the travel smooth: both of those force a full redraw per frame. -->
    <Grid x:Name="Root" Background="{ThemeResource PocketGlassDense}" PointerEntered="Root_PointerEntered" PointerExited="Root_PointerExited" GotFocus="Root_GotFocus" LostFocus="Root_LostFocus">
        <Border Margin="1" BorderBrush="{ThemeResource PocketGlassRim}" BorderThickness="1" CornerRadius="19" IsHitTestVisible="False" />
        <Border Margin="1" BorderBrush="{ThemeResource PocketGlassTopEdge}" BorderThickness="0,1,0,0" CornerRadius="19" IsHitTestVisible="False" />
        <!-- Closed: only this strip, at the bottom of the window, is on screen. -->
        <Grid x:Name="CollapsedView" Height="40" VerticalAlignment="Bottom" Padding="12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="CollapsedDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource PocketRed}" />
            <TextBlock x:Name="CollapsedTimerText" Grid.Column="1" VerticalAlignment="Center" Text="0:00" FontFamily="Cascadia Mono" FontSize="17" Foreground="{ThemeResource PocketInk}" />
            <StackPanel x:Name="CollapsedMeter" Grid.Column="2" Orientation="Horizontal" Height="14" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2" />
        </Grid>

        <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0" Padding="13,11" RowSpacing="9">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ExpandedSlide" Y="-10" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Ellipse Fill="#55FF5A67" />
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource PocketRed}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeText" Text="Recording" FontFamily="Segoe UI Variable Text" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PocketInk}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DeviceText" Text="Microphone" FontFamily="Segoe UI Variable Text" FontSize="13" Foreground="{ThemeResource PocketInkDim}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="TimerText" Grid.Column="2" VerticalAlignment="Center" Text="0:00" FontFamily="Cascadia Mono" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource PocketInk}" />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ExpandedMeter" Orientation="Horizontal" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="2" />
                <Button x:Name="StopButton" Grid.Column="1" MinWidth="112" Height="40" Click="Stop_Click" Content="Stop and save" Style="{StaticResource PocketPrimaryButton}" AutomationProperties.Name="Stop and save recording" />
                <Button x:Name="DiscardButton" Grid.Column="2" Width="40" Height="40" Click="Discard_Click" Style="{StaticResource PocketDangerIconButton}" ToolTipService.ToolTip="Discard recording" AutomationProperties.Name="Discard recording">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource PocketRed}" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>

