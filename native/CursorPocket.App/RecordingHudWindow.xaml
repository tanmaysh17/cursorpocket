<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.RecordingHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recording">
    <!-- Tucked against the top edge as a small pill while recording, and only as
         large as it needs to be when the user reaches for it. Escape always stops
         and saves, so the actions being one hover away never traps a recording. -->
    <Grid x:Name="Root" Background="#FF09110F" PointerEntered="Root_PointerEntered" PointerExited="Root_PointerExited" GotFocus="Root_GotFocus">
        <Grid x:Name="CollapsedView" Padding="12,0" ColumnSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="CollapsedDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource PocketRed}" />
            <TextBlock x:Name="CollapsedTimerText" Grid.Column="1" VerticalAlignment="Center" Text="0:00" FontFamily="Cascadia Mono" FontSize="13" FontWeight="SemiBold" Foreground="White" />
            <StackPanel x:Name="CollapsedMeter" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2" />
        </Grid>

        <Grid x:Name="ExpandedView" Visibility="Collapsed" Padding="18,14" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="30" Height="30" VerticalAlignment="Center">
                <Ellipse Fill="#55FF5A67" />
                <Ellipse Width="10" Height="10" Fill="{StaticResource PocketRed}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="ModeText" Text="Recording" FontSize="17" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="DeviceText" Text="Microphone" MaxWidth="210" FontSize="13" Foreground="#FFF4FAF7" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                <TextBlock x:Name="TimerText" Text="0:00" FontFamily="Cascadia Mono" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                <StackPanel x:Name="ExpandedMeter" Orientation="Horizontal" Height="26" VerticalAlignment="Bottom" Spacing="2" />
            </StackPanel>
            <Button x:Name="StopButton" Grid.Column="3" MinWidth="104" MinHeight="38" Click="Stop_Click" Content="Stop &amp; save" BorderThickness="0" FontSize="14" FontWeight="SemiBold" Style="{StaticResource PocketPrimaryButton}" AutomationProperties.Name="Stop and save recording" />
            <Button x:Name="DiscardButton" Grid.Column="4" Width="38" Height="38" Click="Discard_Click" Background="#32FF5A67" BorderThickness="0" CornerRadius="11" ToolTipService.ToolTip="Discard recording" AutomationProperties.Name="Discard recording">
                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource PocketRed}" />
            </Button>
        </Grid>
    </Grid>
</Window>
