<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.RecordingHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recording">
    <Grid Padding="10" Background="Transparent">
        <Border Padding="20,16" Background="#FF09110F" CornerRadius="20" BorderThickness="0" Translation="0,0,24">
            <Border.Shadow><ThemeShadow /></Border.Shadow>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="250" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Width="38" Height="38"><Ellipse Fill="#55FF5A67" /><Ellipse Width="12" Height="12" Fill="{StaticResource PocketRed}" /></Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock x:Name="ModeText" Text="Recording" FontSize="17" FontWeight="SemiBold" Foreground="White" /><TextBlock x:Name="DeviceText" Text="Microphone" MaxWidth="250" FontSize="13" Foreground="#FFF4FAF7" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8"><TextBlock x:Name="TimerText" Text="0:00" FontFamily="Cascadia Mono" FontSize="22" FontWeight="SemiBold" Foreground="White" /><ProgressBar x:Name="LevelBar" Height="6" Minimum="0" Maximum="1" Foreground="{StaticResource PocketGreen}" Background="#FF25332D" /></StackPanel>
                <Button Grid.Column="3" MinWidth="116" MinHeight="44" Click="Stop_Click" Content="Stop &amp; save" BorderThickness="0" FontSize="14" FontWeight="SemiBold" Style="{StaticResource PocketPrimaryButton}" AutomationProperties.Name="Stop and save recording" />
                <Button Grid.Column="4" Width="44" Height="44" Click="Discard_Click" Background="#32FF5A67" BorderThickness="0" CornerRadius="12" ToolTipService.ToolTip="Discard recording" AutomationProperties.Name="Discard recording"><FontIcon Glyph="&#xE74D;" Foreground="{StaticResource PocketRed}" /></Button>
            </Grid>
        </Border>
    </Grid>
</Window>
