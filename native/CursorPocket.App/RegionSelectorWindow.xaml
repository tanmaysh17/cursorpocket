<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.RegionSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Select a region">
    <Grid x:Name="Root" Background="{ThemeResource PocketBase}">
        <Image x:Name="BackdropImage" IsHitTestVisible="False" Stretch="Fill" />
        <Canvas
            x:Name="Surface"
            Background="#78030907"
            KeyDown="Surface_KeyDown"
            PointerMoved="Surface_PointerMoved"
            PointerPressed="Surface_PointerPressed"
            PointerReleased="Surface_PointerReleased">
            <Border
                Canvas.Left="28"
                Canvas.Top="28"
                Padding="16,12"
                Background="{ThemeResource PocketGlassRaised}"
                CornerRadius="{StaticResource PocketCardCorner}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource PocketBodyStrongText}" Text="Drag the region to capture" />
                        <TextBlock Style="{StaticResource PocketMetaText}" Text="Release to continue" />
                    </StackPanel>
                    <Rectangle
                        Width="1"
                        VerticalAlignment="Stretch"
                        Fill="{ThemeResource PocketLine}" />
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Border
                            Height="24"
                            MinWidth="24"
                            Padding="7,0"
                            BorderBrush="{ThemeResource PocketLineStrong}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource PocketNumericText}" Text="Esc" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource PocketMetaText}"
                            Text="cancels" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Rectangle
                x:Name="Selection"
                Fill="#1445E08C"
                RadiusX="8"
                RadiusY="8"
                Stroke="{ThemeResource PocketGreen}"
                StrokeThickness="2"
                Visibility="Collapsed" />
            <Border
                x:Name="SizeBadge"
                Padding="8,4"
                Background="{ThemeResource PocketGlassRaised}"
                CornerRadius="7"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="SizeText"
                    FontFamily="Cascadia Mono"
                    FontSize="12"
                    Foreground="{ThemeResource PocketGreen}"
                    IsTextScaleFactorEnabled="False" />
            </Border>
        </Canvas>
    </Grid>
</Window>

