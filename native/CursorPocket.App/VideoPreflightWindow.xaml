<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.VideoPreflightWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Set up screen recording">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid
        x:Name="Root"
        Padding="24"
        KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PocketDisplayText}" Text="Before you record" />
                <TextBlock Style="{StaticResource PocketCaptionText}" Text="Nothing is captured until you press start." />
            </StackPanel>
        </Grid>

        <!-- The left inspector is the only scrolling region. The fixed preview and
             footer keep framing, readiness, and Start visible at every scale. -->
        <Grid
            Grid.Row="1"
            Margin="0,20"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" />
                <ColumnDefinition Width="9*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                x:Name="OptionsPanel"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Margin="0,0,8,0" Spacing="12">
                    <Border Background="Transparent">
                        <StackPanel Padding="16" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Style="{StaticResource PocketSubtitleText}" Text="Screen" />
                            </StackPanel>
                            <ComboBox
                                x:Name="SourceBox"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Recording source"
                                SelectedIndex="0"
                                SelectionChanged="SourceBox_SelectionChanged">
                                <ComboBoxItem Content="Display under pointer" Tag="display" />
                                <ComboBoxItem Content="Select a region after setup" Tag="region" />
                                <ComboBoxItem Content="Window used before CursorPocket" Tag="window" />
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{ThemeResource PocketMuted}"
                                    Glyph="&#xE7F4;" />
                                <TextBlock
                                    x:Name="SourceSummary"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PocketMetaText}"
                                    Text="Current display · pointer included" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" BorderBrush="{ThemeResource PocketLine}" BorderThickness="0,1,0,0">
                        <StackPanel Padding="16" Spacing="12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Style="{StaticResource PocketSubtitleText}" Text="Microphone" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="MicrophoneToggle"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="MicrophoneToggle_Toggled"
                                    AutomationProperties.Name="Record the microphone" />
                            </Grid>
                            <ComboBox
                                x:Name="MicrophoneBox"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Name"
                                SelectionChanged="MicrophoneBox_SelectionChanged"
                                AutomationProperties.Name="Microphone" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar
                                    x:Name="MicrophoneLevel"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource PocketSunken}"
                                    Foreground="{ThemeResource PocketGreen}"
                                    Maximum="1"
                                    Minimum="0"
                                    Value="0" />
                                <TextBlock
                                    x:Name="MicrophoneStatus"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PocketMetaText}"
                                    Text="Checking…" />
                            </Grid>
                            <!--  Cleanup is applied when the recording is finalized, never live,
                                  so a filter problem can only ever cost the cleanup, not the take.  -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch
                                    x:Name="NoiseSuppressionToggle"
                                    MinWidth="0"
                                    Header="Noise suppression"
                                    OffContent=""
                                    OnContent=""
                                    AutomationProperties.Name="Noise suppression" />
                                <ToggleSwitch
                                    x:Name="AutoLevelToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    Header="Auto-level volume"
                                    OffContent=""
                                    OnContent=""
                                    AutomationProperties.Name="Auto-level volume" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" BorderBrush="{ThemeResource PocketLine}" BorderThickness="0,1,0,0">
                        <Grid Padding="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Style="{StaticResource PocketSubtitleText}" Text="Camera" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="CameraToggle"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="CameraToggle_Toggled"
                                    AutomationProperties.Name="Record the camera" />
                            </Grid>
                            <StackPanel
                                x:Name="CameraOptions"
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                Spacing="12"
                                Visibility="Collapsed">
                                <ComboBox
                                    x:Name="CameraBox"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Name"
                                    SelectionChanged="CameraBox_SelectionChanged"
                                    AutomationProperties.Name="Camera" />
                                <TextBlock Style="{StaticResource PocketBodyStrongText}" Text="Camera appearance" />
                                <StackPanel Spacing="12">
                                <StackPanel
                                    x:Name="CameraSourceNotice"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <FontIcon
                                        VerticalAlignment="Top"
                                        FontSize="14"
                                        Foreground="{ThemeResource PocketMuted}"
                                        Glyph="&#xE7BA;" />
                                    <TextBlock
                                        x:Name="CameraSourceNoticeText"
                                        Style="{StaticResource PocketCaptionText}"
                                        Text="Window recordings capture only that window, so the camera will be visible on screen but will not appear in the saved file."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="CameraPositionBox"
                                        HorizontalAlignment="Stretch"
                                        Header="Position"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="Bottom right" Tag="bottom-right" />
                                        <ComboBoxItem Content="Bottom left" Tag="bottom-left" />
                                        <ComboBoxItem Content="Top right" Tag="top-right" />
                                        <ComboBoxItem Content="Top left" Tag="top-left" />
                                    </ComboBox>
                                    <ComboBox
                                        x:Name="CameraSizeBox"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Header="Size"
                                        SelectedIndex="1">
                                        <ComboBoxItem Content="Small" Tag="240" />
                                        <ComboBoxItem Content="Medium" Tag="360" />
                                        <ComboBoxItem Content="Large" Tag="480" />
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="CameraShapeBox"
                                        HorizontalAlignment="Stretch"
                                        Header="Shape"
                                        SelectedIndex="0"
                                        SelectionChanged="CameraEffect_SelectionChanged">
                                        <ComboBoxItem Content="Rounded 16:9" Tag="rounded" />
                                        <ComboBoxItem Content="Squircle 1:1" Tag="squircle" />
                                    </ComboBox>
                                    <ComboBox
                                        x:Name="CameraTouchUpBox"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Header="Touch-up"
                                        SelectedIndex="0"
                                        SelectionChanged="CameraEffect_SelectionChanged">
                                        <ComboBoxItem Content="Off" Tag="0" />
                                        <ComboBoxItem Content="Subtle" Tag="1" />
                                        <ComboBoxItem Content="Strong" Tag="2" />
                                    </ComboBox>
                                </Grid>
                                <ComboBox
                                    x:Name="CameraBackgroundBox"
                                    HorizontalAlignment="Stretch"
                                    Header="Background"
                                    SelectedIndex="0"
                                    SelectionChanged="CameraBackgroundBox_SelectionChanged">
                                    <ComboBoxItem Content="Real background" Tag="none" />
                                    <ComboBoxItem Content="Blur" Tag="blur" />
                                    <ComboBoxItem Content="Graphite" Tag="asset:graphite" />
                                    <ComboBoxItem Content="Slate" Tag="asset:slate" />
                                    <ComboBoxItem Content="Moss" Tag="asset:moss" />
                                    <ComboBoxItem Content="Custom image…" Tag="custom" />
                                </ComboBox>
                                <StackPanel
                                    x:Name="EffectAssetsNotice"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <FontIcon
                                        VerticalAlignment="Top"
                                        FontSize="14"
                                        Foreground="{ThemeResource PocketMuted}"
                                        Glyph="&#xE7BA;" />
                                    <TextBlock
                                        Style="{StaticResource PocketCaptionText}"
                                        Text="Background effects are unavailable: the effect assets are not installed with this build."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid ColumnSpacing="10" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PocketCaptionText}"
                                        Text="Brightness" />
                                    <Slider
                                        x:Name="BrightnessSlider"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Minimum="-100"
                                        StepFrequency="5"
                                        ValueChanged="CameraEffect_SliderChanged"
                                        Value="0"
                                        AutomationProperties.Name="Camera brightness" />
                                    <TextBlock
                                        x:Name="BrightnessValue"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource PocketNumericText}"
                                        Text="0" />
                                    <TextBlock
                                        Grid.Row="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PocketCaptionText}"
                                        Text="Warmth" />
                                    <Slider
                                        x:Name="WarmthSlider"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Minimum="-100"
                                        StepFrequency="5"
                                        ValueChanged="CameraEffect_SliderChanged"
                                        Value="0"
                                        AutomationProperties.Name="Camera warmth" />
                                    <TextBlock
                                        x:Name="WarmthValue"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource PocketNumericText}"
                                        Text="0" />
                                    <TextBlock
                                        Grid.Row="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PocketCaptionText}"
                                        Text="Contrast" />
                                    <Slider
                                        x:Name="ContrastSlider"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Minimum="-100"
                                        StepFrequency="5"
                                        ValueChanged="CameraEffect_SliderChanged"
                                        Value="0"
                                        AutomationProperties.Name="Camera contrast" />
                                    <TextBlock
                                        x:Name="ContrastValue"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource PocketNumericText}"
                                        Text="0" />
                                </Grid>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock
                                x:Name="CameraStatus"
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                Style="{StaticResource PocketMetaText}"
                                Text="Off · no camera device is opened" />
                        </Grid>
                    </Border>

                    <StackPanel Padding="16,12,16,4" Spacing="12">
                            <TextBlock Style="{StaticResource PocketSubtitleText}" Text="Recording options" />
                            <ToggleSwitch
                                x:Name="PointerToggle"
                                Header="Include the Windows pointer"
                                IsOn="True" />
                            <ComboBox
                                x:Name="FrameRateBox"
                                HorizontalAlignment="Stretch"
                                Header="Frame rate"
                                SelectedIndex="0">
                                <ComboBoxItem Content="30 fps · balanced" Tag="30" />
                                <ComboBoxItem Content="60 fps · smoother" Tag="60" />
                            </ComboBox>
                            <ComboBox
                                x:Name="CountdownBox"
                                HorizontalAlignment="Stretch"
                                Header="Countdown"
                                SelectedIndex="1">
                                <ComboBoxItem Content="No countdown" Tag="0" />
                                <ComboBoxItem Content="3 seconds" Tag="3" />
                                <ComboBoxItem Content="5 seconds" Tag="5" />
                            </ComboBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!--  The whole panel is the camera. This is where the effects are judged,
                  so the feed gets the entire area rather than sitting as a thumbnail
                  inside a diagram of the screen. The format facts stay, over a scrim
                  along the bottom, so nothing has to move into a dialog.  -->
            <Border
                Grid.Column="1"
                Background="#FF0F171C"
                BorderBrush="{ThemeResource PocketLineStrong}"
                BorderThickness="1"
                CornerRadius="{StaticResource PocketCardCorner}">
                <Grid x:Name="FramingWell" CornerRadius="{StaticResource PocketCardCorner}">
                    <MediaPlayerElement
                        x:Name="CameraPreview"
                        AreTransportControlsEnabled="False"
                        AutoPlay="True"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />
                    <!--  The effects preview: the same pipeline the recording self-view
                          runs, so this shows exactly what lands in the file.  -->
                    <Image
                        x:Name="CameraSlotEffectView"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />
                    <!--  Kept so the shape and position controls still have somewhere to
                          report themselves once the feed covers the panel.  -->
                    <Border
                        x:Name="CameraSlot"
                        Margin="12"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#99000000"
                        CornerRadius="6"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="FramingLabel"
                            Style="{StaticResource PocketTagText}"
                            Text="Full display" />
                    </Border>
                    <TextBlock
                        x:Name="CameraSlotLabel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource PocketMetaText}"
                        Text="camera off" />
                    <Border
                        VerticalAlignment="Bottom"
                        Background="#B3070D0B"
                        CornerRadius="0,0,11,11">
                        <StackPanel
                            Margin="12,9"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border Style="{StaticResource PocketTagBorder}">
                                <TextBlock Style="{StaticResource PocketTagText}" Text="MP4 · H.264" />
                            </Border>
                            <Border Style="{StaticResource PocketTagBorder}">
                                <TextBlock
                                    x:Name="FrameRateTag"
                                    Style="{StaticResource PocketTagText}"
                                    Text="30 FPS" />
                            </Border>
                            <Border Style="{StaticResource PocketTagBorder}">
                                <TextBlock
                                    x:Name="MicrophoneTag"
                                    Style="{StaticResource PocketTagText}"
                                    Text="Mic on" />
                            </Border>
                            <Border Style="{StaticResource PocketTagBorder}">
                                <TextBlock
                                    x:Name="CountdownTag"
                                    Style="{StaticResource PocketTagText}"
                                    Text="3 S" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Ellipse
                    x:Name="ReadinessDot"
                    Width="6"
                    Height="6"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource PocketMuted}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ReadinessTitle"
                        Style="{StaticResource PocketBodyText}"
                        Text="Checking recording devices…" />
                    <TextBlock
                        x:Name="ReadinessDetail"
                        Margin="0,2,0,0"
                        Style="{StaticResource PocketMetaText}"
                        Text="A countdown runs after this window closes." />
                </StackPanel>
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="Cancel_Click"
                    Content="Cancel"
                    Style="{StaticResource PocketQuietButton}" />
                <Button
                    x:Name="StartButton"
                    Click="Start_Click"
                    Style="{StaticResource PocketPrimaryButton}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Start recording" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Mono"
                            FontSize="12"
                            IsTextScaleFactorEnabled="False"
                            Opacity="0.62"
                            Text="&#x21B5;" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

