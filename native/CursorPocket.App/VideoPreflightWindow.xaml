<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CursorPocket_App.VideoPreflightWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Set up screen recording">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt" /></Window.SystemBackdrop>
    <Grid x:Name="Root" Padding="28" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="SCREEN RECORDING" Foreground="{StaticResource PocketGreen}" FontFamily="Cascadia Mono" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" />
                <TextBlock Text="Set the room before you record" Style="{StaticResource PocketDisplayText}" />
                <TextBlock Text="Nothing starts until you confirm the source, microphone, and camera." Style="{StaticResource PocketCaptionText}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click" Background="Transparent"><FontIcon Glyph="&#xE711;" /></Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,20" ColumnSpacing="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*" /><ColumnDefinition Width="4*" /></Grid.ColumnDefinitions>

            <StackPanel Spacing="16">
                <Border Padding="18" Background="{StaticResource PocketSurface}" CornerRadius="14" BorderBrush="{StaticResource PocketLine}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="1 · Screen" Style="{StaticResource PocketTitleText}" />
                        <ComboBox x:Name="SourceBox" Header="Recording source" SelectedIndex="0">
                            <ComboBoxItem Content="Display under pointer" Tag="display" />
                            <ComboBoxItem Content="Select a region after setup" Tag="region" />
                            <ComboBoxItem Content="Window used before CursorPocket" Tag="window" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7F4;" Foreground="{StaticResource PocketGreen}" /><TextBlock x:Name="SourceSummary" Text="Current display · pointer included" Style="{StaticResource PocketCaptionText}" /></StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="18" Background="{StaticResource PocketSurface}" CornerRadius="14" BorderBrush="{StaticResource PocketLine}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid><TextBlock Text="2 · Microphone" Style="{StaticResource PocketTitleText}" /><ToggleSwitch x:Name="MicrophoneToggle" HorizontalAlignment="Right" Toggled="MicrophoneToggle_Toggled" /></Grid>
                        <ComboBox x:Name="MicrophoneBox" Header="Microphone" DisplayMemberPath="Name" SelectionChanged="MicrophoneBox_SelectionChanged" />
                        <StackPanel Spacing="6"><ProgressBar x:Name="MicrophoneLevel" Minimum="0" Maximum="1" Value="0" Foreground="{StaticResource PocketGreen}" /><TextBlock x:Name="MicrophoneStatus" Text="Checking microphone permission and signal…" Style="{StaticResource PocketCaptionText}" /></StackPanel>
                    </StackPanel>
                </Border>

                <Expander Header="More recording options">
                    <StackPanel Padding="0,12,0,4" Spacing="12">
                        <ToggleSwitch x:Name="PointerToggle" Header="Include the Windows pointer" IsOn="True" />
                        <ComboBox x:Name="FrameRateBox" Header="Frame rate" SelectedIndex="0"><ComboBoxItem Content="30 fps · balanced" Tag="30" /><ComboBoxItem Content="60 fps · smoother" Tag="60" /></ComboBox>
                        <ComboBox x:Name="CountdownBox" Header="Countdown" SelectedIndex="1"><ComboBoxItem Content="No countdown" Tag="0" /><ComboBoxItem Content="3 seconds" Tag="3" /><ComboBoxItem Content="5 seconds" Tag="5" /></ComboBox>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <Border Grid.Column="1" Padding="18" Background="{StaticResource PocketRaised}" CornerRadius="14" BorderBrush="{StaticResource PocketLine}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><TextBlock Text="3 · Camera" Style="{StaticResource PocketTitleText}" /><ToggleSwitch x:Name="CameraToggle" HorizontalAlignment="Right" Toggled="CameraToggle_Toggled" /></Grid>
                    <Grid Grid.Row="1" Margin="0,14">
                        <Border Background="#FF080D0F" CornerRadius="12" />
                        <MediaPlayerElement x:Name="CameraPreview" AreTransportControlsEnabled="False" AutoPlay="True" Visibility="Collapsed" />
                        <StackPanel x:Name="CameraEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><Grid Width="58" Height="58"><Ellipse Fill="{StaticResource PocketGreenSoft}" /><FontIcon Glyph="&#xE714;" Foreground="{StaticResource PocketGreen}" FontSize="22" /></Grid><TextBlock x:Name="CameraStatus" Text="Camera is off" Style="{StaticResource PocketCaptionText}" /></StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Spacing="12">
                        <ComboBox x:Name="CameraBox" Header="Camera" DisplayMemberPath="Name" SelectionChanged="CameraBox_SelectionChanged" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><ComboBox x:Name="CameraPositionBox" Header="Position" SelectedIndex="0"><ComboBoxItem Content="Bottom right" Tag="bottom-right" /><ComboBoxItem Content="Bottom left" Tag="bottom-left" /><ComboBoxItem Content="Top right" Tag="top-right" /><ComboBoxItem Content="Top left" Tag="top-left" /></ComboBox><ComboBox x:Name="CameraSizeBox" Grid.Column="1" Header="Size" SelectedIndex="1"><ComboBoxItem Content="Small" Tag="240" /><ComboBoxItem Content="Medium" Tag="360" /><ComboBoxItem Content="Large" Tag="480" /></ComboBox></Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel Spacing="4"><TextBlock x:Name="ReadinessTitle" Text="Checking recording devices…" Style="{StaticResource PocketBodyText}" /><TextBlock x:Name="ReadinessDetail" Text="CursorPocket will show a countdown after this setup closes." Style="{StaticResource PocketCaptionText}" /></StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Click="Cancel_Click" Content="Cancel" Style="{StaticResource PocketQuietButton}" /><Button x:Name="StartButton" Click="Start_Click" Content="Start recording  ↵" Style="{StaticResource PocketPrimaryButton}" /></StackPanel>
        </Grid>
    </Grid>
</Window>
